---
import type { Lang } from '../config';
import { copy } from '../content';
import built from '../../public/corridor/manifest.json';

interface Props {
  lang: Lang;
}
const t = copy[Astro.props.lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// What the page needs of the build's manifest (scripts/corridor-video.mjs): sizes, stills, and
// for each variant of the clip its length, its caption cues and its sources. Byte counts stay
// behind.
type Built = typeof built;
type BuiltSet = Built['sets']['desktop'];
const slim = (s: BuiltSet) => ({
  w: s.w,
  h: s.h,
  poster: s.poster,
  first: s.first,
  last: s.last,
  stills: s.stills,
  clips: Object.fromEntries(
    Object.entries(s.clips).map(([id, f]) => [
      id,
      {
        duration: f.duration,
        frames: f.frames,
        cues: f.cues,
        sources: f.sources.map((x) => ({ codec: x.codec, src: x.src, type: x.type })),
        ...('scare' in f ? { scare: f.scare } : {}),
      },
    ]),
  ),
});
const manifest = { sets: { desktop: slim(built.sets.desktop), mobile: slim(built.sets.mobile) } };
const phone = manifest.sets.mobile;
---

<section class="corr" id="corridor" data-dark="0.2" aria-labelledby="corridor-title">
  <div class="corr__pin" data-corridor data-base={`${base}/corridor/`} data-manifest={JSON.stringify(manifest)} data-next="file" data-state="idle" style={`--corr-w:${phone.w};--corr-h:${phone.h}`}>
    <div class="corr__view" data-view role="img" aria-label={t.corridor.alt}>
      {/* The only picture that loads with the page: the first frame, small. It stays under
          everything else for good, so the stage is never empty. Decoded with the page, not
          when it first comes on screen: Safari would show the bare stage for a moment. */}
      <picture>
        <source media="(orientation: portrait), (max-width: 760px)" srcset={`${base}/corridor/${manifest.sets.mobile.poster}`} />
        <img class="corr__poster" data-poster src={`${base}/corridor/${manifest.sets.desktop.poster}`} alt="" decoding="sync" fetchpriority="low" />
      </picture>
      {/* The stills: the first frame and the last at full size, and two doors on the way for
          visitors who asked for reduced motion. The script gives them their source, and puts
          the clip between them. */}
      <img class="corr__pic" data-pic="first" alt="" />
      <img class="corr__pic" data-pic="still-1" alt="" />
      <img class="corr__pic" data-pic="still-2" alt="" />
      <img class="corr__pic" data-pic="last" alt="" />
    </div>
    <div class="corr__head wrap">
      <p class="place"><span class="place__no">02</span><span>{t.places.corridor}</span></p>
      <h2 class="corr__title" id="corridor-title">{t.corridor.title}</h2>
    </div>
    <ol class="corr__caps wrap">
      {t.corridor.captions.map((c) => <li data-cap>{c}</li>)}
    </ol>
    <button class="corr__tap" type="button" data-corr-tap hidden><span>{t.corridor.tap}</span></button>
    <button class="corr__btn" type="button" data-corr-skip aria-label={t.corridor.skipLabel} hidden>{t.corridor.skip}</button>
    <button class="corr__btn" type="button" data-corr-replay aria-label={t.corridor.replayLabel} hidden>{t.corridor.replay}</button>
  </div>
</section>

<style>
  /* One screen, like any other section. The stage shows a still: the first frame before the
     clip has played, the last door after. While the clip plays the script takes the stage out
     of the page and holds it over the whole screen (.is-held), and holds the page (the rules
     for html.corr-lock at the end). */
  .corr {
    position: relative;
    height: 100vh;
    height: 100lvh;
    background: #050404;
  }
  .corr__pin {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: #050404;
  }
  /* Held: fixed over everything the page scrolls, under the page's own layers (the torch at 40,
     the header and the bars at 60, the grain at 90). As tall as the tallest the screen gets,
     so it covers the screen whatever the browser's bars are doing, and the same height it has
     in the page, so nothing inside it moves when it is taken or let go. A finger on it moves
     nothing. */
  .corr__pin.is-held {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    height: 100vh;
    height: 100lvh;
    touch-action: none;
    overscroll-behavior: contain;
  }
  /* The picture: the stills, and between them the clip (the script adds the video). The scare
     leans the whole picture in towards the door. */
  .corr__view {
    position: absolute;
    inset: 0;
    /* a stacking context of its own: the layers inside are restacked as they change, and none
       of them may climb over the heading, the captions or the buttons */
    z-index: 0;
    isolation: isolate;
    background: #050404;
  }
  .corr__poster,
  .corr__pic,
  :global(.corr__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    pointer-events: none;
  }
  .corr__pic,
  :global(.corr__video) {
    opacity: 0;
  }
  .corr__pic.is-on,
  :global(.corr__video.is-on) {
    opacity: 1;
  }
  /* Darkness behind the heading and the captions, so the text stays readable over the picture. */
  .corr__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 55%, rgba(5, 4, 4, 0.4) 100%),
      linear-gradient(rgba(5, 4, 4, 0.72), transparent 24%, transparent 56%, rgba(5, 4, 4, 0.86));
    pointer-events: none;
  }
  /* Phones, and anything held upright: the picture is a band across the screen, as wide as the
     screen and as tall as its own shape makes it (the phone set: a window cut from the
     landscape frames that keeps the far end of the corridor in the picture). Above it the
     heading, below it the captions; its upper and lower edge run out into the dark of the
     stage, which is the dark of the picture's own corners.
     The same media query picks the phone set in the script. */
  @media (orientation: portrait), (max-width: 760px) {
    .corr__view {
      --band: calc(100vw * var(--corr-h) / var(--corr-w));
      inset: auto 0 auto 0;
      top: max(0px, calc((100svh - var(--band)) * 0.42));
      height: min(100%, var(--band));
    }
    .corr__view::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 100000;
      background: linear-gradient(#050404, rgba(5, 4, 4, 0.5) 7%, rgba(5, 4, 4, 0) 20%, rgba(5, 4, 4, 0) 80%, rgba(5, 4, 4, 0.5) 93%, #050404);
      pointer-events: none;
    }
    .corr__pin::after {
      background: linear-gradient(rgba(5, 4, 4, 0.6), transparent 20%, transparent 70%, rgba(5, 4, 4, 0.7));
    }
  }
  .corr__head {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--header-h) + 16px);
    z-index: 2;
    display: grid;
    gap: 10px;
  }
  .corr__title {
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    line-height: 1;
  }
  .corr__caps {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100lvh - 100svh + 96px);
    z-index: 2;
    display: grid;
  }
  .corr__caps li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 18ch;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.7rem, 7.4vw, 3.4rem);
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 2px 24px #000;
  }
  /* One caption at a time, each up for under two seconds of the clip: it comes and goes in a
     fifth of a second, so that most of its time it is fully there (the build checks the times,
     scripts/corridor-video.mjs). */
  :global(html.motion) .corr__caps li {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  :global(html.motion) .corr__caps li.is-on {
    opacity: 1;
    transform: none;
  }
  /* Phones: the floating "ask" button (WaFloat.astro: 52 px wide, in the right gutter) sits
     level with the caption. The caption keeps out of its column, with 16 px between them. */
  @media (max-width: 899px) {
    :global(html.motion) .corr__caps li {
      max-width: min(18ch, calc(100% - 68px));
    }
  }

  /* Skip while the clip plays, Replay once it has: one place, top right of the stage, level
     with the heading (the rule of the place label runs above it), far from the captions and
     from the floating button at the bottom. 44 px to touch. */
  .corr__btn {
    position: absolute;
    top: calc(var(--header-h) + 42px);
    right: var(--gutter);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--brass-lo);
    background: rgba(7, 6, 6, 0.72);
    color: var(--brass-hi);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .corr__btn:hover,
  .corr__btn:focus-visible {
    border-color: var(--brass-hi);
    color: var(--bone);
  }
  @media (min-width: 900px) {
    .corr__btn {
      top: calc(var(--header-h) + 50px);
    }
  }
  /* Where the browser will not start a video by itself (an iPhone in Low Power Mode): the
     whole stage is the button, and the words sit in the middle of the picture. A finger on it
     can still scroll the page: nothing is held until the clip plays. */
  .corr__tap {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: rgba(5, 4, 4, 0.3);
    font-family: var(--mono);
  }
  .corr__tap span {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 14px 26px;
    border: 1px solid var(--brass-lo);
    background: rgba(7, 6, 6, 0.78);
    color: var(--brass-hi);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .corr__tap:focus-visible {
    outline: none;
  }
  .corr__tap:focus-visible span {
    outline: 2px solid var(--brass-hi);
    outline-offset: 3px;
  }
  .corr__btn[hidden],
  .corr__tap[hidden] {
    display: none;
  }

  /* The page, held while the clip plays (corridor.ts). The body is taken out of the flow at the
     place it was scrolled to, so there is nothing left to scroll: no listener has to stop a
     wheel or a finger. Where the scrollbar takes room, the room is kept, so nothing shifts
     sideways (a browser that cannot keep the room keeps the scrollbar). */
  :global(html.corr-lock) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  :global(html.corr-lock.corr-lock--gutter) {
    scrollbar-gutter: stable;
  }
  :global(html.corr-lock.corr-lock--bar) {
    overflow-y: scroll;
  }
  :global(html.corr-lock body) {
    position: fixed;
    left: 0;
    right: 0;
  }
  /* The section the page glides to afterwards takes the focus with it, without a ring. */
  :global([data-corr-landing]:focus) {
    outline: none;
  }

  /* Static version (reduced motion, or no script): no clip, nothing held. Three doors as
     stills, every caption readable. */
  :global(html:not(.motion)) .corr {
    height: auto;
    padding-bottom: 72px;
  }
  :global(html:not(.motion)) .corr__pin {
    display: flex;
    flex-direction: column;
    height: auto;
    overflow: visible;
  }
  :global(html:not(.motion)) .corr__pin::after {
    background: linear-gradient(rgba(5, 4, 4, 0.78), transparent 24vh);
  }
  :global(html:not(.motion)) .corr__head {
    position: relative;
    order: -1;
    padding-top: calc(var(--header-h) + 16px);
    padding-bottom: 24px;
    top: auto;
  }
  :global(html:not(.motion)) .corr__view {
    position: relative;
    inset: auto;
    display: grid;
    gap: 12px;
    width: min(100% - 2 * var(--gutter), var(--max));
    height: auto;
    margin-inline: auto;
    background: none;
  }
  :global(html:not(.motion)) .corr__view::after {
    content: none;
  }
  :global(html:not(.motion)) .corr__pic {
    position: relative;
    inset: auto;
    opacity: 1;
    width: 100%;
    height: 52vh;
    background: #0b0908;
  }
  /* with script the three doors are shown; without it, the small first frame alone */
  :global(html:not(.motion)) .corr__poster {
    position: relative;
    inset: auto;
    height: 52vh;
  }
  :global(html.still) .corr__view picture,
  :global(html:not(.motion)) .corr__pic[data-pic='first'],
  :global(html:not(.js)) .corr__pic {
    display: none;
  }
  :global(html:not(.motion)) .corr__caps {
    position: relative;
    bottom: auto;
    margin-top: 32px;
    gap: 14px;
  }
  :global(html:not(.motion)) .corr__caps li {
    grid-area: auto;
    max-width: none;
    font-size: clamp(1.3rem, 5vw, 2rem);
  }
  @media (min-width: 900px) {
    :global(html:not(.motion)) .corr__view {
      grid-template-columns: repeat(3, 1fr);
    }
    :global(html:not(.motion)) .corr__pic {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
