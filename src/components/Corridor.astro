---
import type { Lang } from '../config';
import { copy } from '../content';
import built from '../../public/corridor/manifest.json';

interface Props {
  lang: Lang;
}
const t = copy[Astro.props.lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// What the page needs of the build's manifest (scripts/corridor-video.mjs): sizes, poses, and
// for each chapter file its length, its caption cues and its sources. Byte counts stay behind.
type Built = typeof built;
type BuiltSet = Built['sets']['desktop'];
const slim = (s: BuiltSet) => ({
  w: s.w,
  h: s.h,
  poster: s.poster,
  poses: s.poses,
  files: Object.fromEntries(
    Object.entries(s.files).map(([id, f]) => [
      id,
      {
        duration: f.duration,
        frames: f.frames,
        cues: f.cues,
        sources: f.sources.map((x) => ({ codec: x.codec, src: x.src, type: x.type })),
        ...('scare' in f ? { scare: f.scare } : {}),
      },
    ]),
  ),
});
const manifest = { sets: { desktop: slim(built.sets.desktop), mobile: slim(built.sets.mobile) } };
const stops = [1, 2];
---

<section class="corr" id="corridor" data-dark="0.2" aria-labelledby="corridor-title">
  {/* Scroll snap, in CSS only. The two tall boxes mark where the page scrolls freely (everything
      up to the first stop, everything from the last stop on); between them the page may rest
      only on a stop. The first stop is the bottom of the first box, the last stop the top of
      the second. */}
  <div class="corr__free corr__free--before" data-stop="0" aria-hidden="true"></div>
  {stops.map((k) => <div class="corr__stop" data-stop={k} style={`--k:${k}`} aria-hidden="true" />)}
  <div class="corr__free corr__free--after" data-stop="3" aria-hidden="true"></div>

  <div class="corr__pin" data-corridor data-base={`${base}/corridor/`} data-manifest={JSON.stringify(manifest)} data-chapter="0" data-state="rest" data-pose="0">
    <div class="corr__view" data-view role="img" aria-label={t.corridor.alt}>
      {/* The only picture that loads with the page: the first frame, small. It stays under
          everything else for good, so the stage is never empty. */}
      <picture>
        <source media="(orientation: portrait), (max-width: 760px)" srcset={`${base}/corridor/${manifest.sets.mobile.poster}`} />
        <img class="corr__poster" data-poster src={`${base}/corridor/${manifest.sets.desktop.poster}`} alt="" decoding="async" fetchpriority="low" />
      </picture>
      {/* The poses: the start, and the end of each chapter. The script gives them their source
          after the first input. */}
      <img class="corr__pose" data-pose="0" alt="" />
      <img class="corr__pose" data-pose="1" alt="" />
      <img class="corr__pose" data-pose="2" alt="" />
      <img class="corr__pose" data-pose="3" alt="" />
    </div>
    <div class="corr__head wrap">
      <p class="place"><span class="place__no">02</span><span>{t.places.corridor}</span></p>
      <h2 class="corr__title" id="corridor-title">{t.corridor.title}</h2>
    </div>
    <ol class="corr__caps wrap">
      {t.corridor.captions.map((c) => <li data-cap>{c}</li>)}
    </ol>
    <a class="corr__skip" href="#file" data-corr-skip aria-label={t.corridor.skipLabel}>{t.corridor.skip}</a>
  </div>
</section>

<style>
  /* A sticky stage in a tall section. The stage never moves while it is pinned, so the scroll
     position inside the section is not seen: it only says which chapter the visitor is at.
       --corr-lead  from the moment the stage pins to the first stop
       --corr-step  from one stop to the next: longer than a screen, so that an ordinary swipe
                    lands on the next stop and only a hard fling carries past it
     After the last stop the section has one more screen, the one the stage leaves with. */
  .corr {
    --corr-lead: 20vh;
    --corr-step: 125vh;
    --corr-screen: 100vh;
    --corr-short: 100vh;
    /* html's scroll padding (global.css): the snap positions are measured inside it */
    --corr-pad-top: var(--header-h);
    --corr-pad-bottom: 84px;
    position: relative;
    height: calc(var(--corr-lead) + 3 * var(--corr-step) + var(--corr-screen));
    background: #050404;
  }
  @supports (height: 1lvh) {
    .corr {
      --corr-lead: 20lvh;
      --corr-step: 125lvh;
      --corr-screen: 100lvh;
      --corr-short: 100svh;
    }
  }
  @media (min-width: 900px) {
    .corr {
      --corr-pad-bottom: 0px;
    }
  }
  .corr__free,
  .corr__stop {
    display: none;
  }
  /* Scroll snap on the page itself, in force only inside the corridor.
     The page is a mandatory snap container, and a snap area taller than the screen may be
     scrolled freely for as long as it covers the screen. So one tall area reaches from above
     the top of the page down to the first stop, another from the last stop to below the end of
     the page, and the rest of the page never snaps or sticks. Between the two only the stops
     are places to rest.
     `overflow-y: clip` keeps the second area from making the page longer. A browser without it
     gets no snapping at all: the chapters still follow the scroll position (corridor.ts). */
  @supports (overflow: clip) {
    :global(html.motion) {
      scroll-snap-type: y mandatory;
    }
    :global(html.motion) .corr {
      overflow-y: clip;
    }
    :global(html.motion) .corr__free,
    :global(html.motion) .corr__stop {
      display: block;
      position: absolute;
      left: 0;
      width: 1px;
      pointer-events: none;
      scroll-snap-align: start;
    }
    /* Covers the screen up to the first stop, and its bottom edge, brought to the bottom of
       the screen, IS the first stop: a marker of its own there would pull the page to it from
       two thirds of a screen away (Chromium snaps to a marker as soon as it is on screen). */
    :global(html.motion) .corr__free--before {
      top: -400vh;
      height: calc(400vh + var(--corr-lead) + var(--corr-short) - var(--corr-pad-bottom));
      scroll-snap-align: end;
    }
    .corr__stop {
      top: calc(var(--corr-lead) + var(--k) * var(--corr-step) + var(--corr-pad-top));
      height: 1px;
    }
    .corr__free--after {
      top: calc(var(--corr-lead) + 3 * var(--corr-step) + var(--corr-pad-top));
      height: 200000px;
    }
  }

  .corr__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
  }
  /* The picture: the poses, and over them the chapter that is playing (the script adds the
     videos). The scare leans the whole picture in towards the door. */
  .corr__view {
    position: absolute;
    inset: 0;
    /* a stacking context of its own: the layers inside are restacked as they change, and none
       of them may climb over the heading, the captions or the skip link */
    z-index: 0;
    isolation: isolate;
    background: #050404;
  }
  .corr__poster,
  .corr__pose,
  :global(.corr__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    pointer-events: none;
  }
  .corr__pose,
  :global(.corr__video) {
    opacity: 0;
  }
  .corr__pose.is-on,
  :global(.corr__video.is-on) {
    opacity: 1;
  }
  /* Darkness behind the heading and the captions, so the text stays readable over the picture. */
  .corr__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 55%, rgba(5, 4, 4, 0.4) 100%),
      linear-gradient(rgba(5, 4, 4, 0.72), transparent 24%, transparent 56%, rgba(5, 4, 4, 0.86));
    pointer-events: none;
  }
  .corr__head {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--header-h) + 16px);
    z-index: 2;
    display: grid;
    gap: 10px;
  }
  .corr__title {
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    line-height: 1;
  }
  .corr__caps {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100lvh - 100svh + 96px);
    z-index: 2;
    display: grid;
  }
  .corr__caps li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 18ch;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.7rem, 7.4vw, 3.4rem);
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 2px 24px #000;
  }
  :global(html.motion) .corr__caps li {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  :global(html.motion) .corr__caps li.is-on {
    opacity: 1;
    transform: none;
  }
  /* Phones: the floating "ask" button (WaFloat.astro: 52 px wide, in the right gutter) sits
     level with the caption. The caption keeps out of its column, with 16 px between them. */
  @media (max-width: 899px) {
    :global(html.motion) .corr__caps li {
      max-width: min(18ch, calc(100% - 68px));
    }
  }

  /* Skip: a small text link at the top right of the stage, level with the heading (the rule
     of the place label runs above it), far from the captions and from the floating button at
     the bottom. 44 px to touch. */
  .corr__skip {
    position: absolute;
    top: calc(var(--header-h) + 42px);
    right: calc(var(--gutter) - 10px);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 10px;
    color: var(--ash);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--brass-lo);
    text-underline-offset: 5px;
    text-shadow: 0 1px 12px #000;
  }
  .corr__skip:hover,
  .corr__skip:focus-visible {
    color: var(--brass-hi);
    text-decoration-color: currentColor;
  }
  @media (min-width: 900px) {
    .corr__skip {
      top: calc(var(--header-h) + 50px);
    }
  }

  /* Static version (reduced motion, or no script): no pin, no snap, no video. The three end
     poses as stills, every caption readable. */
  :global(html:not(.motion)) .corr {
    height: auto;
    padding-bottom: 72px;
  }
  :global(html:not(.motion)) .corr__pin {
    position: relative;
    display: flex;
    flex-direction: column;
    height: auto;
    overflow: visible;
  }
  :global(html:not(.motion)) .corr__pin::after {
    background: linear-gradient(rgba(5, 4, 4, 0.78), transparent 24vh);
  }
  :global(html:not(.motion)) .corr__head {
    position: relative;
    order: -1;
    padding-top: calc(var(--header-h) + 16px);
    padding-bottom: 24px;
    top: auto;
  }
  :global(html:not(.motion)) .corr__view {
    position: relative;
    display: grid;
    gap: 12px;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    background: none;
  }
  :global(html:not(.motion)) .corr__pose {
    position: relative;
    inset: auto;
    opacity: 1;
    width: 100%;
    height: 52vh;
    background: #0b0908;
  }
  /* with script the three end poses are shown; without it, the small first frame alone */
  :global(html:not(.motion)) .corr__poster {
    position: relative;
    inset: auto;
    height: 52vh;
  }
  :global(html.still) .corr__view picture,
  :global(html:not(.motion)) .corr__pose[data-pose='0'],
  :global(html:not(.js)) .corr__pose {
    display: none;
  }
  :global(html:not(.motion)) .corr__caps {
    position: relative;
    bottom: auto;
    margin-top: 32px;
    gap: 14px;
  }
  :global(html:not(.motion)) .corr__caps li {
    grid-area: auto;
    max-width: none;
    font-size: clamp(1.3rem, 5vw, 2rem);
  }
  :global(html:not(.motion)) .corr__skip {
    display: none;
  }
  @media (min-width: 900px) {
    :global(html:not(.motion)) .corr__view {
      grid-template-columns: repeat(3, 1fr);
    }
    :global(html:not(.motion)) .corr__pose {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
