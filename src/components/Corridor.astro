---
import type { Lang } from '../config';
import { copy } from '../content';

interface Props {
  lang: Lang;
}
const t = copy[Astro.props.lang];
---

<section class="corr" id="corridor" data-dark="0.2" aria-labelledby="corridor-title">
  <div class="corr__pin">
    <canvas class="corr__canvas" data-corridor role="img" aria-label={t.corridor.alt}></canvas>
    <div class="corr__head wrap">
      <p class="place"><span class="place__no">02</span><span>{t.places.corridor}</span></p>
      <h2 class="corr__title" id="corridor-title">{t.corridor.title}</h2>
    </div>
    <ol class="corr__caps wrap">
      {t.corridor.captions.map((c) => <li data-cap>{c}</li>)}
    </ol>
  </div>
</section>

<style>
  /* Pinned with position: sticky, which survives mobile address-bar resizes. */
  .corr {
    position: relative;
    height: 420vh;
    background: #050404;
  }
  .corr__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
  }
  .corr__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Edge darkness, so the corridor never looks like a flat render. */
  .corr__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 35%, rgba(5, 4, 4, 0.78) 100%),
      linear-gradient(rgba(5, 4, 4, 0.75), transparent 22%, transparent 62%, rgba(5, 4, 4, 0.9));
    pointer-events: none;
  }
  .corr__head {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--header-h) + 16px);
    z-index: 2;
    display: grid;
    gap: 10px;
  }
  .corr__title {
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    line-height: 1;
  }
  .corr__caps {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100lvh - 100svh + 96px);
    z-index: 2;
    display: grid;
  }
  .corr__caps li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 18ch;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.7rem, 7.4vw, 3.4rem);
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 2px 24px #000;
  }
  :global(html.motion) .corr__caps li {
    opacity: 0;
    will-change: opacity, transform;
  }

  /* Static version: no pin, one still frame, every caption readable. */
  :global(html:not(.motion)) .corr {
    height: auto;
    padding-bottom: 72px;
  }
  :global(html:not(.motion)) .corr__pin {
    position: relative;
    height: auto;
    overflow: visible;
  }
  :global(html:not(.motion)) .corr__pin::after {
    display: none;
  }
  :global(html:not(.motion)) .corr__canvas {
    position: relative;
    height: 62vh;
  }
  :global(html:not(.motion)) .corr__caps {
    position: relative;
    bottom: auto;
    margin-top: 32px;
    gap: 14px;
  }
  :global(html:not(.motion)) .corr__caps li {
    grid-area: auto;
    max-width: none;
    font-size: clamp(1.3rem, 5vw, 2rem);
  }
</style>
