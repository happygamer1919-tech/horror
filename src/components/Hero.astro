---
import type { Lang } from '../config';
import { copy, site } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const brand = site.brand;
const subtitle = site.brandSubtitle[lang];
const cut = brand.lastIndexOf(' ');
const brandLines = cut > 0 ? [brand.slice(0, cut), brand.slice(cut + 1)] : [brand];
const routeAddress = `${site.address.street}, ${site.city[lang]}`;

// Facade geometry, viewBox 600 x 900. Everything is generated, there are no image files.
const COLS = 5;
const ROWS = 5;
const WIN_W = 64;
const WIN_H = 84;
const winX = (c: number) => 92 + c * 88;
const winY = (r: number) => 198 + r * 110;

// The one lit room. Wide screens: second row, under the E. Phones: top row, left of centre,
// where it stays clear of the copy at every phone height. One set of elements, placed by
// CSS (.room, .figure), so there is never a second copy in the DOM.
const LIT = { r: 1, c: 3 };
const LIT_PHONE = { r: 0, c: 1 };
const isLit = (r: number, c: number) => (r === LIT.r && c === LIT.c) || (r === LIT_PHONE.r && c === LIT_PHONE.c);
// Window dressing per cell: c = curtains, b = blinds, h = half curtain, - = bare glass.
const dressing = ['c-b-c', '-ch-b', 'b--c-', 'ch-hc', '-b-c-'];

const windows = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    windows.push({ r, c, x: winX(c), y: winY(r), kind: dressing[r][c], lit: isLit(r, c) });
  }
}
const mullion = `M${WIN_W / 2} 0V${WIN_H}M0 ${WIN_H * 0.42}H${WIN_W}`;

// The curtain that moves: top floor, far right. Its right drape is a layer of its own
// (transform only, facade.ts). Somebody holds it aside while the light is near but not on
// it, and lets it fall the moment the light arrives.
const CURTAIN = { r: 0, c: 4 };
const drapeL = `M0 0H${WIN_W / 2}V6C24 20 16 50 14 ${WIN_H}H0Z`;
const drapeR = `M${WIN_W / 2} 0H${WIN_W}V${WIN_H}H${WIN_W - 14}C${WIN_W - 16} 50 ${WIN_W - 24} 20 ${WIN_W / 2} 6Z`;

// The sign. Four letters are bolted down. The E hangs from one fixing and is built apart,
// as its own small layers, so its flicker never repaints anything else (see neon.ts).
const letters = ['H', 'O', 'T', 'E', 'L'].map((ch, i) => ({ ch, x: 112 + i * 94 }));
const fixed = letters.filter((l) => l.ch !== 'E');
const E = { x: 394, y: 128, box: { x: 326, y: 22, s: 136 }, pivot: { x: 364, y: 56 } };
const eView = `${E.box.x} ${E.box.y} ${E.box.s} ${E.box.s}`;
// The E is HTML text, not SVG text: SVG text under a moving transform is laid out and painted
// again on the main thread, HTML text is not. Lengths are in facade units (--u).
const u = (n: number) => `calc(${n} * var(--u))`;
const eBaseline = E.y - E.box.y;
// A tube section is cut out of the letter with a static mask that feathers over FEATHER
// facade units on each side of an inner boundary, so neighbouring sections cross-fade and no
// seam shows. Outer sides are left open: the glow of a section is never cut off square.
const FEATHER = 4;
const eCut = E.box.x + 63; // where the spine ends and the three bars begin
const band = (dir: string, from: number | null, to: number | null) => {
  const stops = [];
  if (from !== null) stops.push(`transparent ${u(from - FEATHER)}`, `#000 ${u(from + FEATHER)}`);
  if (to !== null) stops.push(`#000 ${u(to - FEATHER)}`, `transparent ${u(to + FEATHER)}`);
  return `linear-gradient(to ${dir}, ${stops.join(', ')})`;
};
const eMask = (m: { x: [number | null, number | null]; y?: [number | null, number | null] }) => {
  const g = [band('right', m.x[0] && m.x[0] - E.box.x, m.x[1] && m.x[1] - E.box.x)];
  if (m.y) g.push(band('bottom', m.y[0] && m.y[0] - E.box.y, m.y[1] && m.y[1] - E.box.y));
  const img = g.join(', ');
  return `-webkit-mask-image:${img};mask-image:${img}` + (m.y ? ';-webkit-mask-composite:source-in;mask-composite:intersect' : '');
};
const eOrigin = `${(((E.pivot.x - E.box.x) / E.box.s) * 100).toFixed(2)}% ${(((E.pivot.y - E.box.y) / E.box.s) * 100).toFixed(2)}%`;
// Tube sections of the E. Each one has its own brightness. Rest levels are what the
// page shows without motion (reduced motion, no script): an uneven, partly lit letter.
const eSegs = [
  { id: 'spine', rest: 0.92, mask: { x: [null, eCut] } },
  { id: 'top', rest: 0.72, mask: { x: [eCut, null], y: [null, 81] } },
  { id: 'mid', rest: 0.28, mask: { x: [eCut, null], y: [81, 105] } },
  { id: 'bot', rest: 0.55, mask: { x: [eCut, null], y: [105, null] } },
] as { id: string; rest: number; mask: { x: [number | null, number | null]; y?: [number | null, number | null] } }[];
// Spark canvas: fixed to the scaffold next to the torn feed cable, it does not sway.
const SPARK = { x: 376, y: 84, w: 112, h: 150 };

const bulbs = Array.from({ length: 11 }, (_, i) => ({ x: 200 + i * 20, dead: i === 3 || i === 8 }));

// Seen only while lightning lights the building: three windows are not empty. Silhouettes with a rim of light, of different heights; one is a child.
const watchers = [
  { r: 0, c: 3, cx: 21, s: 0.92 },
  { r: 1, c: 0, cx: 40, s: 1.04 },
  { r: 3, c: 2, cx: 44, s: 0.62 },
].map((f) => ({ ...f, x: winX(f.c), y: winY(f.r) }));
---

<section
  class="hero"
  id="lobby"
  data-dark="0.97"
  data-dark-touch="0.97"
  aria-labelledby="hero-title"
  style={`--room-x:${winX(LIT.c)};--room-y:${winY(LIT.r)};--room-px:${winX(LIT_PHONE.c)};--room-py:${winY(LIT_PHONE.r)}`}
>
  <canvas class="hero__fog" data-fog aria-hidden="true"></canvas>
  <div class="hero__sky" aria-hidden="true"></div>

  <div class="facade" data-facade>
    <svg class="facade__base" viewBox="0 0 600 900" preserveAspectRatio="xMidYMin slice" role="img" aria-label={t.hero.facadeAlt}>
      <defs>
        <pattern id="brick" width="28" height="14" patternUnits="userSpaceOnUse">
          <path d="M0 13.5H28M14 0V7M0 7H28M0 7V14M28 7V14" stroke="#1b1614" stroke-width="1.2" fill="none"></path>
        </pattern>
        <linearGradient id="wallfade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#352b26"></stop>
          <stop offset="1" stop-color="#241d1a"></stop>
        </linearGradient>
      </defs>

      <g id="bldg">
        <!-- sign scaffold on the roof -->
        <g stroke="#3d342d" stroke-width="2" fill="none">
          <path d="M70 150V34M530 150V34M70 34H530M70 140H530"></path>
          <path d="M70 140L112 34M159 140L112 34M159 140L206 34M253 140L206 34M253 140L300 34M347 140L300 34M347 140L394 34M441 140L394 34M441 140L488 34M530 140L488 34" stroke-width="1" opacity="0.6"></path>
        </g>
        <!-- dead tubes: what the sign looks like with the power off -->
        <g class="tubes tubes--dead" aria-hidden="true">
          {fixed.map((l) => <text x={l.x} y="128">{l.ch}</text>)}
        </g>
        <!-- what is left of the E's mounting: one bracket still holds, the rest gave way -->
        <g fill="none" stroke="#3a322c" stroke-linecap="round">
          <path d={`M${E.pivot.x} 34V${E.pivot.y - 3}`} stroke-width="3"></path>
          <path d="M427 34V45l4 5" stroke-width="3"></path>
          <path d="M370 140v-7M421 140v-5l3-3" stroke-width="2.4"></path>
          <!-- torn feed cable, hanging off the scaffold -->
          <path d="M446 140c1-9-1-15-5-19c-3-3-6-3-9-1" stroke="#1c1715" stroke-width="2.2"></path>
          <path d="M432 120l-3 1M432 120l-2-2" stroke="#8a6a34" stroke-width="0.9"></path>
        </g>

        <!-- building -->
        <rect x="60" y="150" width="480" height="750" fill="url(#wallfade)"></rect>
        <rect x="60" y="150" width="480" height="750" fill="url(#brick)"></rect>
        <rect x="48" y="150" width="504" height="18" fill="#3d342d"></rect>
        <rect x="54" y="168" width="492" height="6" fill="#0f0d0c"></rect>
        <path d="M76 174V900" stroke="#0f0d0c" stroke-width="5"></path>
        <path d="M524 174V900" stroke="#0f0d0c" stroke-width="5"></path>
        <rect x="60" y="742" width="480" height="8" fill="#3d342d"></rect>

        {
          windows.map((w) => (
            <g transform={`translate(${w.x} ${w.y})`}>
              <rect x="-5" y="-5" width={WIN_W + 10} height={WIN_H + 10} fill="#43382f" />
              <rect width={WIN_W} height={WIN_H} fill="#090808" />
              {w.kind === 'c' && !(w.r === CURTAIN.r && w.c === CURTAIN.c) && <path d={`M0 0H${WIN_W}V${WIN_H}H${WIN_W - 14}C${WIN_W - 16} 50 ${WIN_W - 24} 20 ${WIN_W / 2} 6C24 20 16 50 14 ${WIN_H}H0Z`} fill="#2a221d" />}
              {w.r === CURTAIN.r && w.c === CURTAIN.c && <path d={drapeL} fill="#2a221d" />}
              {w.kind === 'h' && <path d={`M0 0H${WIN_W * 0.62}C${WIN_W * 0.55} 30 ${WIN_W * 0.4} 60 ${WIN_W * 0.3} ${WIN_H}H0Z`} fill="#2a221d" />}
              {w.kind === 'b' && <path d={Array.from({ length: 9 }, (_, i) => `M2 ${6 + i * 6}H${WIN_W - 2}`).join('')} stroke="#2c241f" stroke-width="3" />}
            </g>
          ))
        }
        <g id="bldg-bars">
          {
            windows.map((w) => (
              <g transform={`translate(${w.x} ${w.y})`}>
                <path d={mullion} stroke="#43382f" stroke-width="4" />
                <rect x="-9" y={WIN_H + 5} width={WIN_W + 18} height="6" fill="#4a3e35" />
              </g>
            ))
          }
        </g>

        <!-- ground floor -->
        <g>
          <rect x="92" y="772" width="88" height="106" fill="#090808" stroke="#43382f" stroke-width="5"></rect>
          <rect x="420" y="772" width="88" height="106" fill="#090808" stroke="#43382f" stroke-width="5"></rect>
          <path d="M136 772V878M464 772V878" stroke="#43382f" stroke-width="4"></path>
          <!-- entrance: both leaves shut -->
          <rect x="236" y="776" width="128" height="124" fill="#0b0909" stroke="#4b4037" stroke-width="6"></rect>
          <path d="M300 776V900" stroke="#4b4037" stroke-width="5"></path>
          <rect x="288" y="836" width="5" height="20" fill="#6b5327"></rect>
          <rect x="307" y="836" width="5" height="20" fill="#6b5327"></rect>
          <path d="M184 752H416L430 774H170Z" fill="#332a25"></path>
          <rect x="170" y="774" width="260" height="6" fill="#0f0d0c"></rect>
        </g>
      </g>
    </svg>
    <!-- the drape that moves, under the darkness like the rest of the wall -->
    <div class="fx curtain" data-curtain="rest" aria-hidden="true" style={`--x:${winX(CURTAIN.c) + WIN_W / 2};--y:${winY(CURTAIN.r)};--w:${WIN_W / 2};--h:${WIN_H}`}>
      <div class="curtain__drape">
        <svg viewBox={`${WIN_W / 2} 0 ${WIN_W / 2} ${WIN_H}`}><path d={drapeR} fill="#2a221d"></path></svg>
      </div>
      <!-- whoever holds it: a sliver of a face in the gap and the fingers on the edge of the
           drape. Only there while the drape is held (opacity only). -->
      <svg class="curtain__holder" viewBox={`${WIN_W / 2} 0 ${WIN_W / 2} ${WIN_H}`}>
        <path d="M51.6 15.5C47.4 16.4 45.2 20.6 45.6 25.4C46 30 48.4 33.2 51.9 33.6Z" fill="#b9ad9c"></path>
        <ellipse cx="49.1" cy="23.6" rx="1.5" ry="1.05" fill="#0b0808"></ellipse>
        <path d="M50.3 45.4l4.3-.7M49.8 47.9l4.9-.5M50.2 50.4l4.5-.2M51 52.8l3.6.1" stroke="#b9ad9c" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <svg viewBox={`${WIN_W / 2} 0 ${WIN_W / 2} ${WIN_H}`}><path d={`M${WIN_W / 2} 0V${WIN_H}M${WIN_W / 2} ${WIN_H * 0.42}H${WIN_W}`} stroke="#43382f" stroke-width="4"></path></svg>
    </div>
  </div>

  <div class="facade facade--lit" aria-hidden="true">
    <div class="hero__glow"></div>

    <!-- The building as lightning shows it. Invisible except during a strike (facade.ts). -->
    <svg class="facade__storm" viewBox="0 0 600 900" preserveAspectRatio="xMidYMin slice" data-storm>
      <defs>
        <filter id="stormlit" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="linear" slope="1.9" intercept="0.02"></feFuncR>
            <feFuncG type="linear" slope="2.25" intercept="0.035"></feFuncG>
            <feFuncB type="linear" slope="2.9" intercept="0.07"></feFuncB>
          </feComponentTransfer>
        </filter>
        <linearGradient id="stormfall" x1="0" y1="0" x2="1" y2="0.8">
          <stop offset="0" stop-color="#e6edff" stop-opacity="0.2"></stop>
          <stop offset="0.45" stop-color="#e6edff" stop-opacity="0"></stop>
          <stop offset="0.55" stop-color="#05060a" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#05060a" stop-opacity="0.5"></stop>
        </linearGradient>
      </defs>
      <g filter="url(#stormlit)"><use href="#bldg"></use></g>
      <rect x="60" y="150" width="480" height="750" fill="url(#stormfall)"></rect>
      {
        watchers.map((f) => (
          <g transform={`translate(${f.x} ${f.y})`} data-watcher>
            <g transform={`translate(${f.cx} ${WIN_H}) scale(${f.s}) translate(${-f.cx} ${-WIN_H})`}>
              {
                // The rim first (pale, where the flash catches a shoulder and the side of the
                // head), then the body over it, shifted away from the light.
                [
                  { dx: 0, dy: 0, fill: '#aebbd4', o: 0.78, rim: true },
                  { dx: -1.5, dy: 1.3, fill: '#07080c', o: 1, rim: false },
                ].map((l) => (
                  <g class={l.rim ? 'rim' : undefined} transform={`translate(${l.dx} ${l.dy})`} fill={l.fill} opacity={l.o}>
                    <ellipse cx={f.cx} cy="31" rx="7" ry="8.6" />
                    <path d={`M${f.cx - 15} ${WIN_H}C${f.cx - 15} 54 ${f.cx - 10} 46 ${f.cx - 4} 43H${f.cx + 4}C${f.cx + 10} 46 ${f.cx + 15} 54 ${f.cx + 15} ${WIN_H}Z`} />
                  </g>
                ))
              }
            </g>
          </g>
        ))
      }
      <g filter="url(#stormlit)">
        <g transform={`translate(${winX(CURTAIN.c)} ${winY(CURTAIN.r)})`}><path class="storm-drape" d={drapeR} fill="#2a221d"></path></g>
      </g>
      <g class="storm-holder" transform={`translate(${winX(CURTAIN.c)} ${winY(CURTAIN.r)})`}>
        <path d="M51.6 15.5C47.4 16.4 45.2 20.6 45.6 25.4C46 30 48.4 33.2 51.9 33.6Z" fill="#aebbd4"></path>
        <ellipse cx="49.1" cy="23.6" rx="1.5" ry="1.05" fill="#07080c"></ellipse>
        <path d="M50.3 45.4l4.3-.7M49.8 47.9l4.9-.5M50.2 50.4l4.5-.2M51 52.8l3.6.1" stroke="#aebbd4" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
      </g>
      <g filter="url(#stormlit)">
        <use href="#bldg-bars"></use>
      </g>
    </svg>

    <svg class="facade__lit" viewBox="0 0 600 900" preserveAspectRatio="xMidYMin slice">
      <defs>
        <filter id="neonblur" x="-30%" y="-60%" width="160%" height="220%">
          <feGaussianBlur stdDeviation="7"></feGaussianBlur>
        </filter>
        <filter id="softblur" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="10"></feGaussianBlur>
        </filter>
        <linearGradient id="redwash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ff2d2d" stop-opacity="0.07"></stop>
          <stop offset="1" stop-color="#ff2d2d" stop-opacity="0"></stop>
        </linearGradient>
        <!-- The sign as a light source: it shows the scaffold and the top floors in red. -->
        <filter id="redlit" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.64 0.64 0.64 0 0  0.1 0.1 0.1 0 0  0.09 0.09 0.09 0 0  0 0 0 1 0"></feColorMatrix>
        </filter>
        <linearGradient id="redfall" gradientUnits="userSpaceOnUse" x1="0" y1="20" x2="0" y2="500">
          <stop offset="0" stop-color="#fff" stop-opacity="0.6"></stop>
          <stop offset="0.2" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="0.3" stop-color="#fff" stop-opacity="0.72"></stop>
          <stop offset="0.4" stop-color="#fff" stop-opacity="0.34"></stop>
          <stop offset="0.52" stop-color="#fff" stop-opacity="0.13"></stop>
          <stop offset="0.75" stop-color="#fff" stop-opacity="0.02"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <mask id="redmask" maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="500">
          <rect x="0" y="0" width="600" height="500" fill="url(#redfall)"></rect>
        </mask>
        <linearGradient id="roomlight" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d9b46c"></stop>
          <stop offset="1" stop-color="#8a6a34"></stop>
        </linearGradient>
      </defs>

      <!-- red light spilling from the sign onto the scaffold and the top floors -->
      <g mask="url(#redmask)">
        <g filter="url(#redlit)"><use href="#bldg"></use></g>
      </g>
      <rect x="60" y="150" width="480" height="210" fill="url(#redwash)"></rect>

      <!-- the four letters that still hold -->
      {
        fixed.map((l) => (
          <g class="letter">
            <text class="tubes tubes--glow" x={l.x} y="128" filter="url(#neonblur)">
              {l.ch}
            </text>
            <text class="tubes tubes--live" x={l.x} y="128">
              {l.ch}
            </text>
          </g>
        ))
      }

      <!-- room 3-something: someone left the lamp on -->
      <g class="room">
        <rect x="-10" y="-10" width={WIN_W + 20} height={WIN_H + 20} fill="#d9b46c" opacity="0.28" filter="url(#softblur)"></rect>
        <rect width={WIN_W} height={WIN_H} fill="url(#roomlight)" opacity="0.72"></rect>
        <path d={`M0 0H${WIN_W * 0.5}C${WIN_W * 0.46} 34 ${WIN_W * 0.3} 62 ${WIN_W * 0.22} ${WIN_H}H0Z`} fill="#2a2018" opacity="0.9"></path>
        <path d={mullion} stroke="#1a1512" stroke-width="4"></path>
      </g>

      <!-- entrance: a faint light behind the door glass, bulbs under the canopy -->
      <rect x="244" y="784" width="112" height="116" fill="#d9b46c" opacity="0.06" filter="url(#softblur)"></rect>
      {bulbs.map((b) => <circle cx={b.x} cy="779" r="2.6" fill={b.dead ? '#3a2f22' : '#f0cd86'} opacity={b.dead ? 1 : 0.9} />)}
    </svg>

    <!-- whoever is in the lit room. Present on one pass of the light, gone on the next. -->
    <div class="fx figure" data-figure="far" style={`--w:${WIN_W};--h:${WIN_H}`}>
      <svg viewBox={`0 0 ${WIN_W} ${WIN_H}`}>
        <g class="figure__body" fill="#120b07">
          <!-- head tilted to one side, a neck, a square shoulder line, arms hanging -->
          <ellipse cx="45" cy="32.2" rx="6" ry="7.5" transform="rotate(-10 45 32.2)"></ellipse>
          <path d={`M43.8 36H48.2V41.8C51.5 42.6 55.5 43.6 57.6 45.6C59.6 47.5 60 51 60 55L60.4 ${WIN_H}H32L32.4 55C32.4 51 32.8 47.5 34.8 45.6C36.9 43.6 40.5 42.6 43.8 41.8Z`}></path>
          <!-- near the glass, one hand rests on the bar of the window -->
          <path class="figure__hand" d="M33 60C31.6 54 31 47 31.2 41.4" fill="none" stroke="#120b07" stroke-width="3.4" stroke-linecap="round"></path>
          <path class="figure__hand" d="M29.4 41.6v-4.4M31.2 41v-5.6M33 41.4v-4.8" fill="none" stroke="#120b07" stroke-width="1.3" stroke-linecap="round"></path>
        </g>
        <path d={mullion} stroke="#1a1512" stroke-width="4"></path>
      </svg>
    </div>

    <!-- the E: one fixing left, a static lean plus a slow sway, and a bad feed -->
    <div class="fx sign-e" data-dying style={`--x:${E.box.x};--y:${E.box.y};--w:${E.box.s};--h:${E.box.s};--eb:${eBaseline};transform-origin:${eOrigin}`}>
      <div class="e-ink e-ink--dead"><i></i><b></b></div>
      {
        eSegs.map((s) => (
          <>
            <div class="sign-e__seg" data-seg={s.id} style={`opacity:${Math.pow(s.rest, 0.6).toFixed(3)}`}>
              <div class="e-blur"><div class="e-ink e-ink--glow" style={eMask(s.mask)}><i></i><b></b></div></div>
              <div class="e-ink e-ink--red" style={eMask(s.mask)}><i></i><b></b></div>
            </div>
            <div class="sign-e__seg" data-core={s.id} style={`opacity:${Math.pow(s.rest, 1.8).toFixed(3)}`}>
              <div class="e-ink e-ink--live" style={eMask(s.mask)}><i></i><b></b></div>
            </div>
          </>
        ))
      }
      <!-- one dark fill for the whole letter, over the tubes: the sections are stroke only -->
      <div class="e-ink e-ink--fill"><i></i><b></b></div>
      <svg viewBox={eView}>
        <rect x={E.pivot.x - 5} y={E.pivot.y - 4} width="10" height="8" rx="1" fill="#3d342d" stroke="#15110f" stroke-width="0.8"></rect>
        <circle cx={E.pivot.x} cy={E.pivot.y} r="2.6" fill="#5a4f45" stroke="#15110f" stroke-width="0.8"></circle>
      </svg>
    </div>
    <canvas class="fx sparks" data-sparks style={`--x:${SPARK.x};--y:${SPARK.y};--w:${SPARK.w};--h:${SPARK.h}`}></canvas>
  </div>

  <canvas class="hero__rain" data-rain aria-hidden="true"></canvas>

  <div class="hero__body wrap">
    <p class="hero__kicker">
      {t.hero.kicker.map((k, i) => <span>{i > 0 && <i aria-hidden="true">/</i>}{k}</span>)}
    </p>
    <h1 class="hero__title" id="hero-title" lang={site.brandLang}>
      {brandLines.map((l) => <span>{l}</span>)}
    </h1>
    {subtitle && <p class="hero__alt">{subtitle}</p>}
    <p class="hero__line">{t.hero.line}</p>
    <p class="hero__sub">{t.hero.sub}</p>
    <!-- Second light layer, over the copy only: outside the beam the words dim a little
         (they keep 60 percent of their strength), inside it they read at full strength.
         Same beam as the page flashlight: same drift, same finger (torch.ts). -->
    <div class="hero__veil" aria-hidden="true">
      <div class="veil">
        <div class="torch__drift"><div class="torch__drift"><div class="torch__beam"><i></i><i></i><i></i><i></i></div></div></div>
      </div>
    </div>
  </div>

  <!-- Always lit, wherever the light is. -->
  <div class="hero__cta wrap">
    <a class="btn btn--primary" href="#checkin" data-cta>{t.hero.cta}</a>
    <a class="hero__route" href={site.maps.directionsUrl} target="_blank" rel="noopener noreferrer" data-route>
      <span class="btn btn--route">{t.hero.route}</span>
      <span class="hero__addr" data-route-address>{routeAddress}</span>
      <span class="sr-only">{t.hero.routeNote}</span>
    </a>
    <a class="link hero__tel" href={`tel:${site.phone.e164}`}>{t.hero.tel}</a>
  </div>

  <p class="hero__hint" aria-hidden="true"><span></span>{t.hero.hint}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Bottom: the floating WhatsApp button owns the bottom right corner (12px + 52px, plus
       the safe area on phones with a home indicator). The buttons end above it. */
    padding: calc(var(--header-h) + 12px) 0 calc(70px + env(safe-area-inset-bottom, 0px));
    overflow: clip;
  }

  /* Stacking, bottom to top. The page flashlight (.torch, global.css) sits at 40.
       0   .facade            the building: only the beam shows it
      40   .torch             darkness with a hole in it
      41   .hero__sky         lightning in the sky
      44   .hero__fog         WebGL fog, lit by the sign
      45   .facade--lit       everything that emits light: sign, lit room, storm
      46   .hero__rain, scrim, then .dim (global.css): the idle darkness, under the copy
      47   .hero__body        copy, with its own veil on top (60 percent outside the beam)
      49   .hero__cta         buttons: always lit */

  /* WebGL fog. Plain alpha over the darkness (no blend mode: a blended full-size layer
     forces the browser to read back everything under it on every frame). */
  .hero__fog {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 44;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s;
  }
  .hero.has-gl .hero__fog {
    opacity: 1;
  }

  .facade {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--header-h) - 6px);
    height: 70vh;
    height: 70svh;
    /* Portrait tablets: the building stops growing, so its top floor stays above the copy. */
    max-width: 640px;
    margin: 0 auto;
    /* One facade unit (the SVG viewBox is 600 x 900, "xMidYMin slice") as a length, so
       HTML layers can be placed on the drawing. facade.ts sets --u in px where container
       units are missing. */
    container-type: size;
    --u: max(calc(100cqw / 600), calc(100cqh / 900));
  }
  .facade--lit {
    z-index: 45;
    pointer-events: none;
  }
  .facade svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fx {
    position: absolute;
    left: calc(50% + (var(--x) - 300) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
  }
  .fx svg {
    overflow: visible;
  }

  /* CSS fallback for the fog: a still halo behind the sign. Hidden once WebGL runs. */
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 0;
    width: 130%;
    aspect-ratio: 2 / 1;
    transform: translate(-50%, -34%);
    background: radial-gradient(closest-side, rgba(var(--neon-rgb), 0.3), rgba(var(--neon-rgb), 0.08) 55%, transparent 100%);
    pointer-events: none;
    transition: opacity 1.6s;
  }
  .hero.has-gl .hero__glow {
    opacity: 0;
  }

  .tubes {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 104px;
    text-anchor: middle;
    fill: none;
  }
  /* The variable font has overlapping contours. Painting the stroke first and a dark
     fill over it hides the inner overlaps, so only the outer tube line is left. */
  .tubes--dead {
    stroke: #3a1a18;
    stroke-width: 5;
    fill: #100909;
    paint-order: stroke fill;
  }
  .tubes--glow {
    stroke: var(--neon);
    stroke-width: 9;
    opacity: 0.85;
  }
  .tubes--live {
    stroke: #ffd9d2;
    stroke-width: 5;
    fill: #1d0606;
    paint-order: stroke fill;
    filter: drop-shadow(0 0 3px var(--neon));
  }

  /* The loose E. It leans from its one fixing and sways. Only transform and opacity change,
     each on its own small layer. */
  .sign-e {
    transform: rotate(9deg);
    will-change: transform;
  }
  .sign-e__seg,
  .e-blur,
  .e-ink {
    position: absolute;
    inset: 0;
  }
  .sign-e__seg {
    will-change: opacity;
  }
  /* One letter per layer. The strut <i> puts the baseline at --eb facade units from the top
     whatever the font metrics are; the letter itself comes from CSS, so the DOM holds no
     stray text. Stroke first, fill over it: same tube look as the SVG letters. */
  .e-ink {
    line-height: 0;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    font-family: var(--serif);
    font-weight: 800;
    font-size: calc(104 * var(--u));
    paint-order: stroke fill;
    -webkit-text-stroke: calc(5 * var(--u)) currentColor;
  }
  .e-ink i {
    display: inline-block;
    width: 0;
    height: calc(var(--eb) * var(--u));
  }
  .e-ink b {
    font-weight: inherit;
    line-height: 0;
  }
  .e-ink b::before {
    content: 'E';
  }
  .e-ink--dead {
    -webkit-text-stroke-color: #3a1a18;
    color: #100909;
  }
  .e-blur {
    filter: blur(calc(7 * var(--u)));
    opacity: 0.85;
  }
  .e-ink--glow {
    -webkit-text-stroke: calc(9 * var(--u)) var(--neon);
    color: transparent;
  }
  /* A dim tube is deep red, not pale: the red body and the hot core fade apart (neon.ts). */
  .e-ink--red {
    -webkit-text-stroke-color: var(--neon);
    color: transparent;
  }
  .e-ink--live {
    -webkit-text-stroke-color: #ffd9d2;
    color: transparent;
  }
  .e-ink--fill {
    -webkit-text-stroke: 0 transparent;
    color: #170707;
  }
  .e-ink--live b {
    filter: drop-shadow(0 0 calc(3 * var(--u)) var(--neon));
  }
  :global(html.motion) .sign-e {
    animation: e-sway 3.1s ease-in-out infinite alternate;
  }
  @keyframes e-sway {
    from {
      transform: rotate(7.3deg);
    }
    to {
      transform: rotate(10.7deg);
    }
  }
  .sparks {
    display: none;
  }
  :global(html.motion) .sparks {
    display: block;
  }

  /* The lit room and its guest: one window on wide screens, another on phones. */
  .hero {
    --rx: var(--room-px);
    --ry: var(--room-py);
  }
  .room {
    transform: translate(calc(var(--rx) * 1px), calc(var(--ry) * 1px));
  }
  .figure {
    --x: var(--rx);
    --y: var(--ry);
    transition: opacity 0.28s linear;
    will-change: opacity;
  }
  .figure__body {
    transform-origin: 46px 84px;
  }
  .figure[data-figure='gone'] {
    opacity: 0;
  }
  .figure__hand {
    opacity: 0;
  }
  .figure[data-figure='near'] .figure__body {
    transform: translate(-7px, 0) scale(1.42);
  }
  .figure[data-figure='near'] .figure__hand {
    opacity: 1;
  }

  /* The curtain. Held aside: the drape is gathered against the frame. It is let go fast
     and swings a little past its place before it hangs still. Transform only. */
  .curtain {
    overflow: hidden;
  }
  .curtain__drape {
    position: absolute;
    inset: 0;
    transform-origin: 100% 0;
    will-change: transform;
    transition: transform 0.42s cubic-bezier(0.3, 1.7, 0.5, 1);
  }
  .curtain[data-curtain='held'] .curtain__drape {
    transform: scaleX(0.34) skewX(5deg);
    transition: transform 1.1s cubic-bezier(0.4, 0, 0.3, 1);
  }
  .curtain__holder {
    opacity: 0;
    will-change: opacity;
    transition: opacity 0.16s linear;
  }
  .curtain[data-curtain='held'] .curtain__holder {
    opacity: 0.55;
    transition: opacity 0.7s linear 0.5s;
  }

  /* The same drape in the lightning copy of the building: it follows the live one. */
  .storm-drape {
    transform-box: fill-box;
    transform-origin: 100% 0;
  }
  .hero[data-curtain='held'] .storm-drape {
    transform: scaleX(0.34) skewX(5deg);
  }
  .storm-holder {
    opacity: 0;
  }
  .hero[data-curtain='held'] .storm-holder {
    opacity: 0.8;
  }

  /* Lightning: one soft flash with a short decay. Never a double strobe. */
  .facade__storm,
  .hero__sky {
    opacity: 0;
    will-change: opacity;
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: 41;
    pointer-events: none;
    background: radial-gradient(130% 85% at 68% 0%, rgba(184, 202, 240, 0.5), rgba(120, 140, 190, 0.16) 46%, rgba(120, 140, 190, 0) 76%);
  }
  .hero.is-strike .facade__storm,
  .hero.is-strike .hero__sky {
    animation: strike 1.15s linear both;
  }
  .hero.is-strike .hero__veil {
    animation: strike-veil 1.15s linear both;
  }
  /* Held at the peak, for screenshots (window.__hero.storm.hold). */
  .hero.is-storm-hold .facade__storm,
  .hero.is-storm-hold .hero__sky {
    opacity: 1;
  }
  .hero.is-storm-hold .hero__veil {
    opacity: 0.1;
  }
  @keyframes strike {
    0% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    16% {
      opacity: 0.62;
    }
    30% {
      opacity: 0.34;
    }
    50% {
      opacity: 0.15;
    }
    75% {
      opacity: 0.04;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes strike-veil {
    0% {
      opacity: 1;
    }
    7% {
      opacity: 0.1;
    }
    30% {
      opacity: 0.6;
    }
    60% {
      opacity: 0.9;
    }
    100% {
      opacity: 1;
    }
  }

  /* Rain: a small canvas (facade.ts). Streaks only show where something lights them. */
  .hero__rain {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 62%;
    z-index: 46;
    pointer-events: none;
    display: none;
  }
  :global(html.motion) .hero__rain {
    display: block;
  }

  /* While the hero is off screen its looping animations stand still (facade.ts). */
  .hero.is-off .sign-e {
    animation-play-state: paused;
  }

  /* Scrim so the copy stays readable where it overlaps the building on phones. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 30% 0 0 0;
    background: linear-gradient(rgba(7, 6, 6, 0), rgba(7, 6, 6, 0.9) 34%, var(--ink) 56%);
    z-index: 46;
    pointer-events: none;
  }

  .hero__body {
    position: relative;
    z-index: 47;
    display: grid;
    gap: 14px;
  }
  /* The veil is clipped to the copy block, so it never dims the sign or the lit room.
     Inside it the dark layer is fixed to the viewport, like the page flashlight. */
  .hero__veil {
    position: absolute;
    inset: -72px calc(var(--gutter) * -1) -10px;
    z-index: 1;
    /* The mask clips the fixed layer to this box and softens its top edge. It is static:
       the browser composites it, nothing is repainted when the light or the page moves. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 64px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 64px);
    pointer-events: none;
    display: none;
  }
  :global(html.motion) .hero__veil {
    display: block;
  }
  /* One strength everywhere, in every state (touch or pointer, before and after the first
     input): at most 0.4, so the headline and the rest of the copy never drop below 60
     percent of their strength outside the light. The building stays black (that is .torch). */
  .veil {
    position: fixed;
    inset: 0;
    overflow: hidden;
    opacity: 0.4;
  }
  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-hi);
  }
  .hero__kicker i {
    font-style: normal;
    color: var(--brass-lo);
    margin-right: 10px;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(3.1rem, 14.6vw, 7.4rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin-top: 4px;
  }
  .hero__title span {
    display: block;
  }
  /* The name in the page language, under the wordmark (RO and EN only). */
  .hero__alt {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.15rem, 4.8vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--brass-hi);
  }
  .hero__line {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 6.2vw, 2.6rem);
    line-height: 1.1;
    color: var(--neon);
    text-shadow: 0 0 22px rgba(var(--neon-rgb), 0.45);
  }
  .hero__sub {
    max-width: 46ch;
    color: var(--bone);
    opacity: 0.86;
  }

  /* Buttons: booking (red, primary) and the route (brass, second). Phones: two columns,
     the call link under the booking button, the address under the route button. */
  .hero__cta {
    position: relative;
    z-index: 49;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 12px;
    align-items: start;
    margin-top: 26px;
  }
  .hero__cta .btn--primary {
    grid-column: 1;
    grid-row: 1;
  }
  .hero__route {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: start;
    display: grid;
    justify-items: start;
    gap: 7px;
    text-decoration: none;
  }
  .btn--route {
    border-color: var(--brass-hi);
    color: var(--brass-hi);
    background: rgba(185, 151, 91, 0.16);
    box-shadow:
      inset 0 0 0 1px rgba(227, 200, 135, 0.22),
      0 0 22px rgba(227, 200, 135, 0.16);
  }
  .hero__route:hover .btn--route,
  .hero__route:focus-visible .btn--route {
    background: var(--brass-hi);
    color: var(--ink);
  }
  .hero__addr {
    font-size: 11px;
    line-height: 1.45;
    letter-spacing: 0.03em;
    color: var(--ash);
  }
  .hero__tel {
    grid-column: 1;
    grid-row: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
  }
  .hero__hint {
    position: absolute;
    left: max(var(--gutter), calc((100vw - var(--max)) / 2));
    bottom: 18px;
    z-index: 47;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .hero__hint span {
    width: 1px;
    height: 26px;
    background: linear-gradient(var(--ash), transparent);
  }

  /* Short phones: tighten the copy so the sign and the top floors stay clear. */
  @media (max-height: 700px) and (max-width: 899px) {
    .hero__hint {
      bottom: 14px;
    }
    .hero::after {
      inset: 27% 0 0 0;
    }
    /* A smaller building, so the sign and the lit room on the top floor end above the copy. */
    .facade {
      width: clamp(190px, calc((100svh - 536px) * 2.13), 100%);
      height: auto;
      aspect-ratio: 2 / 3;
      margin: 0 auto;
    }
    .hero__body {
      gap: 9px;
    }
    .hero__title {
      font-size: 12.4vw;
    }
    .hero__line {
      font-size: 1.35rem;
    }
    .hero__sub {
      font-size: 13.5px;
      line-height: 1.5;
    }
    .hero__cta {
      margin-top: 15px;
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-bottom: 96px;
      --rx: var(--room-x);
      --ry: var(--room-y);
    }
    .hero::after {
      display: none;
    }
    .facade {
      left: auto;
      right: max(4vw, calc((100vw - var(--max)) / 2 - 40px));
      /* Dropped so the top rail of the sign scaffold clears the header row. */
      top: 22px;
      height: 100vh;
      height: 100svh;
      width: 66.6vh;
      width: 66.6svh;
      max-width: 46vw;
    }
    .hero__rain {
      height: 100%;
    }
    /* The building is smaller on a wide screen: the rim of light on the watchers is stronger. */
    .rim {
      opacity: 0.96;
    }
    .hero__body {
      gap: 18px;
    }
    .hero__title,
    .hero__alt,
    .hero__line,
    .hero__sub,
    .hero__kicker {
      max-width: min(56vw, 760px);
    }
    .hero__veil {
      top: -110px;
      right: auto;
      width: calc(min(56vw, 760px) + var(--gutter) + 150px);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 100px), linear-gradient(to left, transparent 0, #000 170px);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to bottom, transparent 0, #000 100px), linear-gradient(to left, transparent 0, #000 170px);
      mask-composite: intersect;
    }
    .hero__cta {
      grid-template-columns: auto auto auto;
      justify-content: start;
      gap: 0 26px;
      margin-top: 30px;
      padding-bottom: 26px;
    }
    .hero__route {
      grid-row: 1;
      position: relative;
    }
    .hero__addr {
      position: absolute;
      left: 0;
      top: calc(100% + 8px);
      white-space: nowrap;
    }
    .hero__tel {
      grid-column: 3;
      grid-row: 1;
      min-height: 52px;
    }
    .hero__hint {
      bottom: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figure,
    .curtain__drape,
    .curtain__holder {
      transition: none;
    }
  }
</style>
