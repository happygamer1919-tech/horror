---
import type { Lang } from '../config';
import { copy, site, priceFrom, durationRange, CONTACT_LEVELS_ENABLED, LEVELS } from '../content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const k = t.keys;

const fobs = [
  { no: '01', label: k.labels.players, value: `${site.players.min}-${site.players.max}`, small: false, note: '' },
  // A range ("60-90 min") is set in the smaller size, like the price: at the large size the
  // Russian tag is filled edge to edge on a phone and breaks in two on a wide screen.
  { no: '02', label: k.labels.duration, value: k.duration(durationRange), small: site.duration.min !== site.duration.max, note: '' },
  // No age limit: everyone signs an agreement on arrival; with minors in the team a parent
  // signs and the team plays without electroshock.
  { no: '03', label: k.labels.age, value: k.age(site.ageLimit), small: site.ageLimit === null, note: k.ageNote },
  { no: '04', label: k.labels.price, value: k.priceFrom(priceFrom, site.currency), small: true, note: '' },
];
---

<section class="sec keys" id="keys" data-dark="0.4" aria-labelledby="keys-title">
  <div class="wrap">
    <SectionHead no="04" place={t.places.reception} title={k.title} id="keys-title">
      <p class="lead" data-reveal style="--d:.14s">{k.intro}</p>
    </SectionHead>

    <ul class="board">
      {
        fobs.map((f, i) => (
          <li class="hook" data-reveal style={`--d:${i * 0.09}s`} data-fob={f.no}>
            <div class="fob">
              <span class="fob__no" aria-hidden="true">
                {f.no}
              </span>
              <span class="fob__label">{f.label}</span>
              <span class:list={['fob__value', { 'is-small': f.small }]}>{f.value}</span>
              {f.note && <span class="fob__note">{f.note}</span>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      CONTACT_LEVELS_ENABLED && (
        <fieldset class="lvl" data-reveal>
          <legend class="lvl__legend">{k.level.legend}</legend>
          <div class="lvl__pick">
            <div class="lvl__opts">
              {LEVELS.map((l) => (
                <label class="lvl__opt">
                  <input type="radio" name="level-pick" value={l} data-level-input />
                  <span>{k.level.options[l]}</span>
                </label>
              ))}
            </div>
            <p class="lvl__minors" data-minors>
              {k.level.minors}
            </p>
          </div>
          <p class="lvl__text" data-level-note>
            {k.level.note}
          </p>
        </fieldset>
      )
    }
  </div>
</section>

<style>
  /* Key board: a rail with four hooks. */
  .board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 16px;
    padding-top: 14px;
    border-top: 6px solid #1c1714;
    box-shadow: 0 -1px 0 var(--brass-lo);
  }
  .hook {
    position: relative;
    display: grid;
    justify-items: center;
    padding-top: 30px;
  }
  /* hook and ring */
  .hook::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--brass-hi);
    box-shadow: 0 2px 4px #000;
    z-index: 1;
  }
  .hook::after {
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    width: 26px;
    height: 44px;
    margin-left: -13px;
    border: 2px solid var(--brass);
    border-radius: 50%;
  }
  .fob {
    position: relative;
    width: min(100%, 168px);
    min-height: 214px;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 8px;
    padding: 46px 12px 34px;
    text-align: center;
    color: #23190a;
    border-radius: 16px 16px 84px 84px / 16px 16px 60px 60px;
    background:
      repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 3px),
      linear-gradient(160deg, #6f5628 0%, #bb9c5e 24%, #8f7038 50%, #c4a667 72%, #6a5226 100%);
    box-shadow:
      inset 0 0 0 2px rgba(60, 42, 12, 0.55),
      inset 0 0 0 5px rgba(255, 236, 180, 0.16),
      0 18px 30px rgba(0, 0, 0, 0.6);
    transform-origin: 50% -24px;
  }
  /* the hole the ring passes through */
  .fob::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset 0 2px 3px #000, 0 1px 0 rgba(255, 236, 180, 0.5);
  }
  :global(html.motion) .hook.is-in .fob {
    animation: swing 2.4s cubic-bezier(0.3, 0, 0.3, 1) var(--d, 0s) 1 both;
  }
  @keyframes swing {
    0% {
      transform: rotate(-7deg);
    }
    30% {
      transform: rotate(4.5deg);
    }
    55% {
      transform: rotate(-2.4deg);
    }
    78% {
      transform: rotate(1deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  .fob__no {
    font-size: 10px;
    letter-spacing: 0.2em;
    opacity: 0.8;
  }
  .fob__label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(35, 25, 10, 0.5);
  }
  .fob__value {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.05;
    text-shadow: 0 1px 0 rgba(255, 236, 180, 0.45);
    overflow-wrap: anywhere;
  }
  .fob__value.is-small {
    font-size: 1.22rem;
    line-height: 1.12;
  }
  .fob__note {
    max-width: 22ch;
    font-size: 10px;
    font-weight: 500;
    text-wrap: balance;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Level: the names, the one rule that goes with them (teams with minors) and one neutral
     line. Nothing here describes a level. */
  .lvl {
    margin-top: 80px;
    display: grid;
    gap: 22px;
  }
  .lvl__legend {
    padding: 0;
    margin-bottom: 18px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .lvl__pick {
    display: grid;
    gap: 12px;
  }
  /* One cell per level, however many there are. */
  .lvl__opts {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border: 1px solid var(--line);
  }
  .lvl__minors {
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--ash);
  }
  .lvl__opt {
    position: relative;
    display: grid;
    cursor: pointer;
  }
  .lvl__opt + .lvl__opt {
    border-left: 1px solid var(--line);
  }
  .lvl__opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .lvl__opt span {
    display: grid;
    place-items: center;
    min-height: 56px;
    padding: 8px 6px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ash);
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .lvl__opt input:checked + span {
    background: var(--neon);
    color: var(--ink);
  }
  .lvl__opt input:focus-visible + span {
    outline: 2px solid var(--brass-hi);
    outline-offset: 3px;
  }
  .lvl__text {
    max-width: 24ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 6.4vw, 2.6rem);
    line-height: 1.14;
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
    .fob {
      width: min(100%, 210px);
      min-height: 270px;
      padding-top: 56px;
    }
    .fob__value {
      font-size: 2.3rem;
    }
    .fob__value.is-small {
      font-size: 1.6rem;
    }
    .lvl {
      margin-top: 120px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .lvl__legend {
      float: left;
      width: 100%;
      grid-column: 1 / -1;
    }
    .lvl__pick {
      grid-column: 1 / span 6;
      align-self: start;
    }
    .lvl__opt span {
      font-size: 12px;
      letter-spacing: 0.14em;
    }
    .lvl__text {
      grid-column: 8 / -1;
    }
  }
</style>
