---
import type { Lang } from '../config';
import { copy, site, TELEGRAM_URL } from '../content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const v = t.voucher;
// Vouchers are sold at the venue, in cash. The page only answers questions about them.
const message = v.message(site.brand);
const waUrl = `https://wa.me/${site.phone.whatsapp}?text=${encodeURIComponent(message)}`;
---

<section class="sec gift" id="voucher" data-dark="0.25" aria-labelledby="voucher-title">
  <div class="wrap">
    <SectionHead no="07" place={t.places.gift} title={v.title} id="voucher-title">
      <p class="lead" data-reveal style="--d:.14s">{v.text}</p>
    </SectionHead>

    <div class="ticket" data-voucher data-reveal>
      <div class="ticket__stub" aria-hidden="true">
        <span lang={site.brandLang}>{site.brand}</span>
        <b>{v.title}</b>
      </div>
      <div class="ticket__body">
        <dl class="ticket__facts">
          <div>
            <dt>{v.where}</dt>
            <dd>
              {v.whereValue}<br />
              <span>{site.address.street}, {site.city[lang]}</span>
            </dd>
          </div>
          <div>
            <dt>{v.pay}</dt>
            <dd>{v.payValue}</dd>
          </div>
        </dl>
        <div class="ticket__act" role="group" aria-labelledby="voucher-ask">
          <span class="ticket__ask" id="voucher-ask">{v.submit}</span>
          <a class="btn btn--ghost" href={waUrl} target="_blank" rel="noopener noreferrer" data-voucher-wa>WhatsApp</a>
          <a class="btn btn--ghost" href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" data-voucher-tg data-tg data-message={message}>Telegram</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* A brass-edged ticket with a perforated stub. */
  .ticket {
    display: grid;
    max-width: 860px;
    border: 1px solid var(--brass);
    background: var(--ink-2);
  }
  .ticket__stub {
    display: grid;
    gap: 6px;
    align-content: center;
    padding: 22px 20px;
    border-bottom: 1px dashed var(--brass-lo);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .ticket__stub b {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: none;
    color: var(--brass-hi);
  }
  .ticket__body {
    display: grid;
    gap: 26px;
    padding: 22px 20px 24px;
  }
  .ticket__facts {
    display: grid;
    gap: 18px;
  }
  .ticket__facts dt {
    margin-bottom: 4px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .ticket__facts dd {
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--bone);
  }
  .ticket__facts dd span {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ash);
  }
  /* "Message us", then the two channels as equal buttons, the same pair as on the card. */
  .ticket__act {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .ticket__ask {
    grid-column: 1 / -1;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }
  @media (min-width: 900px) {
    .ticket {
      grid-template-columns: 250px 1fr;
    }
    .ticket__stub {
      border-bottom: 0;
      border-right: 1px dashed var(--brass-lo);
      padding: 30px 26px;
    }
    .ticket__body {
      gap: 30px;
      padding: 30px 30px 32px;
    }
    .ticket__facts {
      grid-template-columns: 1.6fr 1fr;
      gap: 24px;
    }
    .ticket__act {
      grid-template-columns: repeat(2, minmax(0, 210px));
      gap: 12px;
    }
  }
</style>
