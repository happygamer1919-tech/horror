---
import type { Lang } from '../config';
import { copy, site } from '../content';

interface Props {
  lang: Lang;
}
const t = copy[Astro.props.lang];
const url = `https://wa.me/${site.phone.whatsapp}?text=${encodeURIComponent(t.ui.waHello(site.brand))}`;
---

<a class="wa" href={url} target="_blank" rel="noopener noreferrer" data-wa-float aria-label={t.ui.whatsapp}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path d="M4 4h16v12H10l-4.5 4v-4H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter"></path>
    <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="2"></path>
  </svg>
  <span>WhatsApp</span>
</a>

<style>
  /* The chat replacement: a square button fixed to the corner, above the flashlight. */
  .wa {
    position: fixed;
    right: var(--gutter);
    bottom: calc(84px + env(safe-area-inset-bottom));
    z-index: 61;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 52px;
    height: 52px;
    padding: 0 15px;
    border: 1px solid var(--brass);
    background: var(--ink);
    color: var(--brass-hi);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    transition:
      bottom 0.4s cubic-bezier(0.3, 0.8, 0.2, 1),
      opacity 0.3s,
      visibility 0.3s,
      background-color 0.25s,
      color 0.25s;
  }
  .wa:hover {
    background: var(--brass-hi);
    color: var(--ink);
  }
  .wa span {
    display: none;
  }
  /* While the Book bar is away (over the hero) the button drops into the corner. */
  :global(body:has(.sticky.is-away)) .wa,
  :global(body:not(:has(.sticky))) .wa {
    bottom: calc(12px + env(safe-area-inset-bottom));
  }
  /* On phones it steps aside while a form is on screen, so it never covers a field. */
  .wa.is-away {
    opacity: 0;
    visibility: hidden;
  }
  @media (min-width: 900px) {
    .wa,
    :global(body:has(.sticky.is-away)) .wa,
    :global(body:not(:has(.sticky))) .wa {
      bottom: 28px;
    }
    .wa span {
      display: inline;
    }
    .wa.is-away {
      opacity: 1;
      visibility: visible;
    }
  }
</style>
