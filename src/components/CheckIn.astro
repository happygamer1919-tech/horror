---
import type { Lang } from '../config';
import { copy, site, priceFor, CONTACT_LEVELS_ENABLED, CONFIRM_CALL_ENABLED, LEVELS, BOOKING_URL, TELEGRAM_URL } from '../content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const c = t.checkin;
const b = t.booking;

// Team size to total price, for the live total on the card.
const priceMap: Record<string, number> = {};
for (let n = site.players.min; n <= site.players.max; n++) {
  const total = priceFor(n);
  if (total !== null) priceMap[n] = total;
}

// The booking widget asks only for name, phone and a comment. The card keeps the rest and
// turns it into one line (scripts/checkin.ts). This is the server-rendered starting state
// of the "ask a question" links. The team size starts empty and no level is chosen, so the
// line holds the page language only: a part without a value is left out.
const hello = c.hello(site.brand);
const startLine = `${c.summary.language}: ${c.languages[lang]}`;
// What the total shows while there is no valid team size (the same text checkin.ts writes).
const NO_TOTAL = '...';
const startMessage = `${hello}\n${startLine}`;
const waUrl = `https://wa.me/${site.phone.whatsapp}?text=${encodeURIComponent(startMessage)}`;
---

<section class="sec checkin" id="checkin" data-dark="0.18" aria-labelledby="checkin-title">
  <div class="wrap">
    <SectionHead no="09" place={t.places.registration} title={c.title} id="checkin-title">
      <p class="lead" data-reveal style="--d:.14s">{c.intro}</p>
    </SectionHead>

    <form
      class="card"
      data-checkin
      data-wa={site.phone.whatsapp}
      data-hello={hello}
      data-labels={JSON.stringify(c.summary)}
      data-prices={JSON.stringify(priceMap)}
      data-currency={site.currency}
      data-slots={BOOKING_URL}
      data-reveal
    >
      <div class="card__head">
        <span class="card__brand" lang={site.brandLang}>{site.brand}</span>
        <span class="card__no">{c.cardNo} 0313</span>
      </div>

      <div class="card__grid">
        <label class="f f--half">
          <span>{c.fields.team}</span>
          <input type="number" name="team" inputmode="numeric" min={site.players.min} max={site.players.max} placeholder={`${site.players.min}-${site.players.max}`} required />
        </label>
        <label class="f f--half">
          <span>{c.fields.language}</span>
          <select name="language" required>
            {site.gameLanguages.map((l) => <option value={c.languages[l]} selected={l === lang}>{c.languages[l]}</option>)}
          </select>
        </label>

        {
          CONTACT_LEVELS_ENABLED && (
            <fieldset class="f f--full card__lvl">
              <legend>{c.fields.level}</legend>
              <div>
                {LEVELS.map((l) => (
                  <label>
                    {/* No default: the team chooses. */}
                    <input type="radio" name="level" value={l} data-name={t.keys.level.options[l]} required data-level-input />
                    <span>{t.keys.level.options[l]}</span>
                  </label>
                ))}
              </div>
              <p class="card__rule" data-minors>
                {t.keys.level.minors}
              </p>
            </fieldset>
          )
        }
      </div>

      <p class="card__total" aria-live="polite">
        <span>{c.total}</span>
        <output name="total" data-total data-empty={NO_TOTAL}>{NO_TOTAL}</output>
      </p>

      <div class="card__foot">
        {
          BOOKING_URL && (
            <>
              {/* The button starts off: the team size is empty and no level is chosen. It comes
                  on when both are (scripts/checkin.ts). The prompt keeps its line when it is
                  hidden, so nothing on the card moves when the button comes on. */}
              <div class="card__book">
                <button class="btn btn--primary card__submit" type="submit" data-book disabled aria-describedby="card-choose">
                  {c.submit}
                </button>
                <p class="card__choose" id="card-choose" data-book-prompt>
                  {c.choose(CONTACT_LEVELS_ENABLED)}
                </p>
              </div>
              {
                CONFIRM_CALL_ENABLED && (
                  <p class="card__confirm" data-confirm-call>
                    {c.confirmCall}
                  </p>
                )
              }
              <p class="card__request" data-request>
                {c.request}
              </p>
            </>
          )
        }
        <div class="card__ask" role="group" aria-labelledby="card-ask">
          <span class="card__ask-label" id="card-ask">
            {t.ui.ask}
          </span>
          <a class="card__ch" href={waUrl} target="_blank" rel="noopener noreferrer" data-ask-wa>
            WhatsApp
          </a>
          <a class="card__ch" href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" data-ask-tg data-tg data-message={startMessage}>
            Telegram
          </a>
        </div>
        <p class="card__tel">
          {c.tel}: <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
        </p>
        <p class="card__note">{c.note}</p>
      </div>
      <p class="card__sign" aria-hidden="true"><span>{c.signature}</span></p>
    </form>

    {
      BOOKING_URL && (
        <dialog class="bk" data-booking data-lenis-prevent aria-labelledby="bk-title" data-url={BOOKING_URL} data-copied={b.copied} data-not-copied={b.notCopied}>
          <div class="bk__bar">
            <div class="bk__top">
              <p class="bk__title" id="bk-title">
                <span lang={site.brandLang}>{site.brand}</span>
                <b>{b.title}</b>
              </p>
              <button class="bk__close" type="button" data-booking-close>
                <span>{b.close}</span>
                <i aria-hidden="true" />
              </button>
            </div>
            <div class="bk__sum">
              <p class="bk__state" role="status" aria-live="polite" data-booking-state />
              <p class="bk__line" data-booking-line />
              <button class="bk__copy" type="button" data-booking-copy>
                {b.copyAgain}
              </button>
            </div>
            <p class="bk__hint">
              <span>{b.instruction}</span>
              <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" data-booking-tab>
                {b.newTab}
              </a>
            </p>
            {
              CONFIRM_CALL_ENABLED && (
                <p class="bk__call" data-confirm-call>
                  {c.confirmCall}
                </p>
              )
            }
          </div>
          <div class="bk__body">
            <p class="bk__slow" data-booking-slow>
              <span>{b.slow}</span>
              <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">
                {b.newTab}
              </a>
            </p>
            <iframe class="bk__frame" title={b.frameTitle} data-booking-frame />
          </div>
        </dialog>
      )
    }
  </div>
</section>

<style>
  .card {
    position: relative;
    max-width: 760px;
    padding: 22px 18px 26px;
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow:
      inset 0 0 70px rgba(84, 62, 30, 0.3),
      0 30px 70px rgba(0, 0, 0, 0.7);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 20px;
    border-bottom: 3px double var(--paper-ink);
  }
  .card__brand {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card__no {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--stamp);
    white-space: nowrap;
  }
  .card__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }
  .f {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .f--full {
    grid-column: 1 / -1;
  }
  .f > span,
  .card__lvl legend {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-ash);
  }
  .card__lvl legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .card__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 26px;
    padding: 12px 0;
    border-block: 1px solid var(--paper-ink);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-ash);
  }
  .card__total output {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 1.7rem;
    letter-spacing: 0;
    color: var(--stamp);
    font-variant-numeric: tabular-nums;
  }
  .card__confirm {
    font-size: 14px;
    font-weight: 500;
  }
  .card__request {
    font-size: 14px;
    font-weight: 500;
  }
  .f input:not([type='radio']),
  .f select {
    width: 100%;
    min-width: 0;
    height: 46px;
    padding: 6px 2px;
    border: 0;
    border-bottom: 1px solid var(--paper-ink);
    border-radius: 0;
    background: transparent;
    color: var(--paper-ink);
    font-family: var(--mono);
    font-size: 16px;
    color-scheme: light;
    appearance: none;
    -webkit-appearance: none;
  }
  .f select {
    background-image: linear-gradient(45deg, transparent 50%, var(--paper-ink) 50%), linear-gradient(135deg, var(--paper-ink) 50%, transparent 50%);
    background-position:
      calc(100% - 12px) 20px,
      calc(100% - 6px) 20px;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }
  /* The range, faint, while the team size is empty. */
  .f input::placeholder {
    color: var(--paper-ash);
    opacity: 0.55;
  }
  .f input:focus-visible,
  .f select:focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }
  /* One cell per level, however many there are. */
  .card__lvl > div {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border: 1px solid var(--paper-ink);
  }
  /* The rule that goes with the levels: teams with minors. */
  .card__rule {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--paper-ash);
  }
  .card__lvl label {
    position: relative;
    display: grid;
    cursor: pointer;
  }
  .card__lvl label + label {
    border-left: 1px solid var(--paper-ink);
  }
  .card__lvl input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .card__lvl label span {
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 52px;
    padding: 6px 4px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }
  .card__lvl input:checked + span {
    background: var(--paper-ink);
    color: var(--paper);
  }
  .card__lvl input:focus-visible + span {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }
  .card__foot {
    display: grid;
    gap: 12px;
    margin-top: 22px;
  }
  .card__submit {
    width: 100%;
    border-color: var(--stamp);
    background: var(--stamp);
    color: #f6efe0;
    box-shadow: none;
  }
  .card__submit:hover {
    background: #6f1410;
    box-shadow: none;
  }
  /* Not yet available: an empty outline on the paper. It fills in with the stamp red once
     the team size and the level are chosen. */
  .card__submit:disabled {
    border-color: rgba(143, 29, 24, 0.5);
    background: transparent;
    color: var(--paper-ash);
    cursor: not-allowed;
  }
  /* Button and its prompt. The prompt always keeps its line: hiding it moves nothing. */
  .card__book {
    display: grid;
    gap: 8px;
  }
  .card__choose {
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stamp);
  }
  .card__choose.is-off {
    visibility: hidden;
  }
  /* Second channel: ask a question on WhatsApp or Telegram. */
  .card__ask {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 10px;
    margin-top: 6px;
    padding-top: 16px;
    border-top: 1px solid rgba(28, 22, 17, 0.35);
  }
  .card__ask-label {
    grid-column: 1 / -1;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-ash);
  }
  .card__ch {
    display: grid;
    place-items: center;
    min-height: 46px;
    padding: 6px 10px;
    border: 1px solid var(--paper-ink);
    color: var(--paper-ink);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  /* Hover only where there is a pointer that hovers: on touch it would stick after the tap. */
  @media (hover: hover) {
    .card__ch:hover {
      background: var(--paper-ink);
      color: var(--paper);
    }
  }
  .card__ch:active {
    background: var(--paper-ink);
    color: var(--paper);
  }
  .card__ch:focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }
  .card__tel {
    font-size: 14px;
  }
  .card__tel a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 500;
    text-underline-offset: 4px;
  }
  .card__note {
    font-size: 12px;
    color: var(--paper-ash);
  }
  .card__sign {
    margin-top: 30px;
    padding-top: 6px;
    border-top: 1px solid var(--paper-ink);
    width: 62%;
    margin-left: auto;
    text-align: right;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-ash);
  }
  @media (min-width: 900px) {
    .card {
      padding: 40px 44px 44px;
      margin-left: calc((100% + 24px) / 12 * 2);
      transform: rotate(-0.5deg);
    }
    .card__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 26px 24px;
    }
    .f--half {
      grid-column: span 1;
    }
    .card__foot {
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: 28px;
    }
    .card__submit {
      width: auto;
    }
    .card__book {
      grid-column: 1 / -1;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 22px;
    }
    .card__confirm,
    .card__request,
    .card__note,
    .card__tel,
    .card__ask {
      grid-column: 1 / -1;
    }
    .f--half {
      grid-column: span 2;
    }
    .card__lvl label span {
      font-size: 12px;
      letter-spacing: 0.1em;
    }
    .card__ask {
      grid-template-columns: auto 190px 190px;
      align-items: center;
      column-gap: 14px;
    }
    .card__ask-label {
      grid-column: auto;
      margin-right: 10px;
    }
  }

  /* Booking dialog: the hotel's frame around the booking widget. Dark, hairline brass
     rules, mono labels. On phones it fills the screen and the bar stays compact, so the
     widget keeps the height. */
  .bk {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }
  .bk[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .bk::backdrop {
    background: rgba(3, 2, 2, 0.86);
  }
  .bk__bar {
    display: grid;
    gap: 10px;
    padding: 10px 14px 12px;
    padding-top: calc(10px + env(safe-area-inset-top));
    border-bottom: 1px solid var(--brass);
  }
  .bk__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .bk__title {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .bk__title b {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
    color: var(--bone);
  }
  .bk__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--brass-lo);
    border-radius: 0;
    background: transparent;
    color: var(--brass-hi);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bk__close:hover {
    border-color: var(--brass-hi);
  }
  /* the cross: two hairlines */
  .bk__close i {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .bk__close i::before,
  .bk__close i::after {
    content: '';
    position: absolute;
    left: -2px;
    top: 6px;
    width: 18px;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .bk__close i::after {
    transform: rotate(-45deg);
  }
  .bk__sum {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 12px;
    padding: 8px 0 8px 12px;
    border-left: 2px solid var(--brass);
  }
  .bk__state {
    grid-column: 1;
    min-height: 1.5em;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .bk__line {
    grid-column: 1;
    font-size: 13px;
    line-height: 1.4;
    color: var(--bone);
    overflow-wrap: anywhere;
    user-select: text;
    -webkit-user-select: text;
  }
  .bk__copy {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-height: 44px;
    max-width: 124px;
    padding: 6px 12px;
    border: 1px solid var(--brass);
    border-radius: 0;
    background: transparent;
    color: var(--brass-hi);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .bk__copy:hover {
    background: var(--brass-hi);
    color: var(--ink);
  }
  /* The clipboard refused: the line is the thing to take, so it is marked and selectable in one tap. */
  .bk.is-manual .bk__sum {
    border-left-color: var(--neon);
  }
  .bk.is-manual .bk__state {
    letter-spacing: 0.04em;
    font-size: 12px;
    text-transform: none;
    color: var(--bone);
  }
  .bk.is-manual .bk__line {
    padding: 6px 8px;
    margin-top: 4px;
    border: 1px dashed var(--brass);
    user-select: all;
    -webkit-user-select: all;
  }
  .bk__hint {
    font-size: 12px;
    line-height: 1.45;
    color: var(--ash);
  }
  .bk__hint span {
    margin-right: 8px;
  }
  .bk__hint a {
    display: inline-block;
    padding-block: 4px;
    color: var(--brass-hi);
    text-underline-offset: 4px;
    text-decoration-color: var(--brass-lo);
    white-space: nowrap;
  }
  /* The desk calls on the day of the game: one quiet line under the hint. Short phones
     leave it out (it is on the card and in the FAQ), so the widget keeps its height. */
  .bk__call {
    font-size: 12px;
    line-height: 1.45;
    color: var(--bone);
  }
  @media (max-height: 700px) and (max-width: 899px) {
    .bk__call {
      display: none;
    }
  }
  .bk__body {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    /* the widget paints its own page black: no seam while it loads */
    background: #000;
  }
  .bk__frame {
    grid-row: 2;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
    color-scheme: normal;
  }
  .bk__slow {
    grid-row: 1;
    display: none;
    gap: 12px;
    justify-items: start;
    padding: 14px;
    border-bottom: 1px solid var(--brass-lo);
    background: var(--ink-2);
    font-size: 13px;
    color: var(--bone);
  }
  .bk.is-slow .bk__slow {
    display: grid;
  }
  .bk__slow .btn {
    min-height: 46px;
    padding-block: 10px;
    box-shadow: none;
  }

  @media (min-width: 900px) {
    .bk {
      width: min(1040px, calc(100vw - 80px));
      height: min(860px, calc(100vh - 56px));
      margin: auto;
      border: 1px solid var(--brass);
      box-shadow: 0 40px 120px rgba(0, 0, 0, 0.8);
    }
    .bk__bar {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px 28px;
      padding: 18px 22px 16px;
    }
    .bk__top {
      grid-column: 1 / -1;
    }
    .bk__title b {
      font-size: 1.6rem;
    }
    .bk__sum {
      grid-column: 1;
      gap: 2px 18px;
      padding-left: 16px;
    }
    .bk__line {
      font-size: 15px;
    }
    .bk__copy {
      max-width: none;
    }
    .bk__hint {
      grid-column: 2;
      align-self: center;
      max-width: 34ch;
      font-size: 13px;
    }
    .bk__hint a {
      display: block;
      width: max-content;
    }
    .bk__call {
      grid-column: 1 / -1;
      font-size: 13px;
    }
    .bk__slow {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: 14px 22px;
    }
  }
</style>
