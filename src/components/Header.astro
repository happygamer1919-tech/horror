---
import { LANGS, href, type Lang } from '../config';
import { copy, site } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<header class="bar">
  <a class="bar__brand" href="#top">
    <span class="bar__key" aria-hidden="true"></span>
    <span class="bar__name">{site.brand[lang]}</span>
  </a>
  <div class="bar__tools">
    <nav class="langs" aria-label={t.ui.languageNav}>
      {
        LANGS.map((l) => (
          <a href={href(`/${l}/`)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined} aria-label={copy[l].langName}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <button
      class="sound"
      type="button"
      aria-pressed="false"
      data-sound
      data-label={t.ui.sound}
      data-on={t.ui.soundOn}
      data-off={t.ui.soundOff}
      aria-label={`${t.ui.sound}: ${t.ui.soundOff}`}
    >
      <span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: var(--gutter);
    background: linear-gradient(rgba(7, 6, 6, 0.92), rgba(7, 6, 6, 0));
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--bone);
    text-decoration: none;
    white-space: nowrap;
  }
  /* A small key drawn with borders: bow and shaft. */
  .bar__key {
    position: relative;
    width: 11px;
    height: 11px;
    border: 2px solid var(--neon);
    border-radius: 50%;
    margin-bottom: 9px;
    flex: none;
  }
  .bar__key::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 10px;
    margin-left: -1px;
    background: var(--neon);
    box-shadow: 3px 6px 0 -0.01px var(--neon);
  }
  .bar__tools {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .langs {
    display: flex;
  }
  .langs a {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 44px;
    color: var(--ash);
    text-decoration: none;
  }
  .langs a[aria-current='page'] {
    color: var(--bone);
    text-decoration: underline;
    text-decoration-color: var(--neon);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .langs a:hover {
    color: var(--bone);
  }
  .sound {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
  }
  .sound__bars {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 16px;
  }
  .sound__bars i {
    width: 2px;
    height: 3px;
    background: var(--ash);
    transition: height 0.3s;
  }
  .sound[aria-pressed='true'] .sound__bars i {
    background: var(--neon);
  }
  .sound[aria-pressed='true'] .sound__bars i:nth-child(1) {
    height: 8px;
  }
  .sound[aria-pressed='true'] .sound__bars i:nth-child(2) {
    height: 16px;
  }
  .sound[aria-pressed='true'] .sound__bars i:nth-child(3) {
    height: 11px;
  }
  .sound[aria-pressed='true'] .sound__bars i:nth-child(4) {
    height: 5px;
  }
  @media (max-width: 359px) {
    .bar__name {
      display: none;
    }
  }
</style>
