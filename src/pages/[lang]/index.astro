---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Preloader from '../../components/Preloader.astro';
import Hero from '../../components/Hero.astro';
import Corridor from '../../components/Corridor.astro';
import File from '../../components/File.astro';
import Keys from '../../components/Keys.astro';
import Cctv from '../../components/Cctv.astro';
import Proof from '../../components/Proof.astro';
import CheckIn from '../../components/CheckIn.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import Sticky from '../../components/Sticky.astro';
import { LANGS, abs, type Lang } from '../../config';
import { copy, site } from '../../content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
const address = `${site.address.street}, ${site.address.postalCode}, ${site.city[lang]}`;
const faq = t.faq.items({
  players: site.players,
  age: site.ageLimit,
  price: site.price,
  phone: site.phone.display,
  address,
  minutes: site.durationMinutes,
});

// Structured data. Base.astro only prints it when SITE_INDEXABLE=true.
// Placeholder answers (TODO values) are never published as FAQ data.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${abs(`/${lang}/`)}#business`,
    name: site.brand[lang],
    alternateName: LANGS.filter((l) => l !== lang).map((l) => site.brand[l]),
    description: t.meta.description,
    url: abs(`/${lang}/`),
    telephone: site.phone.e164,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.city[lang],
      addressCountry: site.countryCode,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: site.rating.value,
      reviewCount: site.rating.count,
      bestRating: 5,
    },
    hasMap: site.maps.profileUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faq
      .filter((i) => i.known)
      .map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
  },
];
---

<Base lang={lang} jsonLd={jsonLd}>
  <Preloader lang={lang} />
  <Header lang={lang} />
  <main id="main">
    <div id="top"></div>
    <Hero lang={lang} />
    <Corridor lang={lang} />
    <File lang={lang} />
    <Keys lang={lang} />
    <Cctv lang={lang} />
    <Proof lang={lang} />
    <CheckIn lang={lang} />
    <Faq lang={lang} items={faq} />
  </main>
  <Footer lang={lang} />
  <Sticky lang={lang} />
  <script>
    import '../../scripts/main.ts';
  </script>
</Base>
