---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Preloader from '../../components/Preloader.astro';
import Hero from '../../components/Hero.astro';
import Corridor from '../../components/Corridor.astro';
import File from '../../components/File.astro';
import Keys from '../../components/Keys.astro';
import Cctv from '../../components/Cctv.astro';
import Proof from '../../components/Proof.astro';
import CheckIn from '../../components/CheckIn.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import Sticky from '../../components/Sticky.astro';
import Prices from '../../components/Prices.astro';
import Voucher from '../../components/Voucher.astro';
import { LANGS, SITE_ORIGIN, abs, type Lang } from '../../config';
import { copy, site, priceFrom, durationRange, instagramUrl, faqFor, VOUCHERS_ENABLED } from '../../content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
const faq = faqFor(lang);

// Structured data. Base.astro only prints it when SITE_INDEXABLE=true.
// One business and one website for all three pages: the @id is the same on every language,
// so search engines and AI assistants see one entity, not three.
const businessId = `${SITE_ORIGIN}/#business`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'EntertainmentBusiness',
    '@id': businessId,
    name: site.brand,
    alternateName: Object.values(site.brandSubtitle).filter(Boolean),
    description: t.meta.description(durationRange),
    url: abs(`/${lang}/`),
    logo: abs('/logo.png'),
    image: abs(`/og/${lang}.jpg`),
    telephone: site.phone.e164,
    priceRange: `${priceFrom}-${Math.max(...site.prices.map((p) => p.total))} ${site.currency}`,
    currenciesAccepted: site.currency,
    paymentAccepted: 'Cash',
    knowsLanguage: site.gameLanguages,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.city[lang],
      addressCountry: site.countryCode,
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    openingHoursSpecification: site.hours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.schema,
      opens: h.open,
      closes: h.close,
    })),
    hasMap: site.maps.profileUrl,
    ...(instagramUrl ? { sameAs: [instagramUrl] } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_ORIGIN}/#website`,
    url: `${SITE_ORIGIN}/`,
    name: site.brand,
    alternateName: Object.values(site.brandSubtitle).filter(Boolean),
    inLanguage: [...LANGS],
    publisher: { '@id': businessId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faq
      .filter((i) => i.known)
      .map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
  },
];
---

<Base lang={lang} jsonLd={jsonLd}>
  <Preloader lang={lang} />
  <Header lang={lang} />
  <main id="main">
    <div id="top"></div>
    <Hero lang={lang} />
    <Corridor lang={lang} />
    <File lang={lang} />
    <Keys lang={lang} />
    <Prices lang={lang} />
    <Cctv lang={lang} />
    {VOUCHERS_ENABLED && <Voucher lang={lang} />}
    {/* The guest book comes right before the registration card: proof, then the booking. */}
    <Proof lang={lang} />
    <CheckIn lang={lang} />
    <Faq lang={lang} items={faq} />
  </main>
  <Footer lang={lang} />
  <Sticky lang={lang} />
  <script>
    import '../../scripts/main.ts';
  </script>
</Base>
