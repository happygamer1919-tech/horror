---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Preloader from '../../components/Preloader.astro';
import Hero from '../../components/Hero.astro';
import Corridor from '../../components/Corridor.astro';
import File from '../../components/File.astro';
import Keys from '../../components/Keys.astro';
import Cctv from '../../components/Cctv.astro';
import Proof from '../../components/Proof.astro';
import CheckIn from '../../components/CheckIn.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import Sticky from '../../components/Sticky.astro';
import Prices from '../../components/Prices.astro';
import Voucher from '../../components/Voucher.astro';
import { LANGS, abs, type Lang } from '../../config';
import { copy, site, priceFrom, CONTACT_LEVELS_ENABLED, VOUCHERS_ENABLED } from '../../content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
const address = `${site.address.street}, ${site.address.postalCode}, ${site.city[lang]}`;
const faq = t.faq.items({
  minutes: site.durationMinutes,
  players: site.players,
  priceFrom: t.keys.priceFrom(priceFrom, site.currency),
  age: site.ageLimit,
  payment: site.paymentMethods ? site.paymentMethods[lang] : null,
  phone: site.phone.display,
  address,
  levels: CONTACT_LEVELS_ENABLED,
  vouchers: VOUCHERS_ENABLED,
});

// Structured data. Base.astro only prints it when SITE_INDEXABLE=true.
// Placeholder answers (TODO values) are never published as FAQ data.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${abs(`/${lang}/`)}#business`,
    name: site.brand,
    alternateName: Object.values(site.brandSubtitle).filter(Boolean),
    description: t.meta.description,
    url: abs(`/${lang}/`),
    image: abs(`/og/${lang}.jpg`),
    telephone: site.phone.e164,
    priceRange: `${priceFrom}-${Math.max(...site.prices.map((p) => p.total))} ${site.currency}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.city[lang],
      addressCountry: site.countryCode,
    },
    openingHoursSpecification: site.hours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.schema,
      opens: h.open,
      closes: h.close,
    })),
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: site.rating.value,
      reviewCount: site.rating.count,
      bestRating: 5,
    },
    hasMap: site.maps.profileUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faq
      .filter((i) => i.known)
      .map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
  },
];
---

<Base lang={lang} jsonLd={jsonLd}>
  <Preloader lang={lang} />
  <Header lang={lang} />
  <main id="main">
    <div id="top"></div>
    <Hero lang={lang} />
    <Corridor lang={lang} />
    <File lang={lang} />
    <Keys lang={lang} />
    <Prices lang={lang} />
    <Cctv lang={lang} />
    <Proof lang={lang} />
    {VOUCHERS_ENABLED && <Voucher lang={lang} />}
    <CheckIn lang={lang} />
    <Faq lang={lang} items={faq} />
  </main>
  <Footer lang={lang} />
  <Sticky lang={lang} />
  <script>
    import '../../scripts/main.ts';
  </script>
</Base>
